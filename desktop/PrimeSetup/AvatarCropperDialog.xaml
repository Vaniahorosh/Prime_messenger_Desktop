<Window x:Class="PrimeSetup.AvatarCropperDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка аватара" Height="500" Width="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#0F1117" BorderBrush="#252D3D" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title bar -->
                <RowDefinition Height="*"/>    <!-- Crop viewport -->
                <RowDefinition Height="Auto"/> <!-- Controls -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Настройка аватара профиля" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Click="BtnCancel_Click"
                        Background="Transparent" Foreground="#8B949E" BorderThickness="0" FontSize="13" Cursor="Hand"/>
            </Grid>

            <!-- Viewport -->
            <Border Grid.Row="1" Background="#070A0F" CornerRadius="12" ClipToBounds="True" BorderBrush="#1C2536" BorderThickness="1">
                <Grid x:Name="ViewportGrid" ClipToBounds="True">
                    <Image x:Name="ImgPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Circular mask overlay -->
                    <Path Fill="#B0000000">
                        <Path.Data>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry x:Name="CropFullRect"/>
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <EllipseGeometry x:Name="CropHoleCircle"/>
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>

                    <Border x:Name="CropBorder" BorderBrush="#4D9FFF" BorderThickness="2"
                            CornerRadius="999" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Quick controls (Rotate) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,12">
                <Button Content="↶ Повернуть влево" Click="BtnRotateCCW_Click"
                        Background="#161B22" Foreground="#C9D1D9" BorderBrush="#30363D" BorderThickness="1"
                        Padding="12,6" Margin="0,0,8,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                </Button>
                <Button Content="↷ Повернуть вправо" Click="BtnRotateCW_Click"
                        Background="#161B22" Foreground="#C9D1D9" BorderBrush="#30363D" BorderThickness="1"
                        Padding="12,6" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- Bottom Actions -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Отмена" Click="BtnCancel_Click"
                        Background="#161B22" Foreground="#8B949E" BorderBrush="#30363D" BorderThickness="1"
                        Height="36" Width="100" HorizontalAlignment="Left" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                </Button>
                <Button Grid.Column="1" Content="✓ Применить" Click="BtnApply_Click"
                        Background="#4D9FFF" Foreground="#FFFFFF" FontWeight="Bold"
                        Height="36" Width="120" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
