<Window x:Class="PrimeSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка Prime Desktop" Height="580" Width="820"
        Icon="Assets/prime.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#0C0E14"
            BorderBrush="#252D3D"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="20,14,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top bar with only Close button -->
                <RowDefinition Height="*"/>    <!-- Split Content: Left Promo & Right Settings -->
                <RowDefinition Height="Auto"/> <!-- Bottom Row: Progress bar & Install Button -->
            </Grid.RowDefinitions>

            <!-- Top bar: Clean draggable area with ONLY the close button -->
            <Grid Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent" Height="32">
                <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right" Click="CloseButton_Click"
                        Background="Transparent" Foreground="#8B949E" BorderThickness="0"
                        FontSize="15" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2D1519"/>
                                                <Setter Property="Foreground" Value="#FF6B6B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Split Main Content Area -->
            <Grid Grid.Row="1" Margin="4,0,4,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/> <!-- Left Medium Column: Logo & Animated Slogans -->
                    <ColumnDefinition Width="24"/>  <!-- Divider / Gap -->
                    <ColumnDefinition Width="*"/>   <!-- Right Column: Profile Photo, Name, Settings -->
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Logo & Animated Slogans -->
                <Border Grid.Column="0" Background="#121620" BorderBrush="#1F2636" BorderThickness="1" CornerRadius="16" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>    <!-- Center Logo -->
                            <RowDefinition Height="Auto"/> <!-- Animated Slogans at bottom-half -->
                        </Grid.RowDefinitions>

                        <!-- Centered Logo -->
                        <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10">
                            <Border Width="110" Height="110" CornerRadius="28" Background="#161C28" BorderBrush="#2F394D" BorderThickness="1.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.35" Color="#38BDF8"/>
                                </Border.Effect>
                                <Image Source="Assets/prime.ico" Width="72" Height="72"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </Grid>

                        <!-- Animated Slogans & Badges -->
                        <Border Grid.Row="1" Height="140" Background="#181F2C" BorderBrush="#253046" BorderThickness="1" CornerRadius="12" Padding="14,12" ClipToBounds="True">
                            <Grid x:Name="SloganContainer" VerticalAlignment="Center">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="SloganTranslate" Y="0"/>
                                </Grid.RenderTransform>

                                <StackPanel HorizontalAlignment="Center">
                                    <!-- Dynamic Animated Title -->
                                    <TextBlock x:Name="TxtSloganPrefix" Text="Всегда будь в"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#8B949E"
                                               HorizontalAlignment="Center" Margin="0,0,0,2"/>

                                    <TextBlock x:Name="TxtSloganButton" Text="Прайме!"
                                               FontSize="20" FontWeight="Bold" Foreground="#38BDF8"
                                               HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                    <TextBlock x:Name="TxtSloganSubtitle" Text="Мессенджер нового поколения"
                                               FontSize="11.5" FontWeight="SemiBold" Foreground="#C9D1D9"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                    <TextBlock x:Name="TxtSloganDesc" Text="Приватный и свободный мессенджер для общения по Bluetooth P2P и онлайн."
                                               FontSize="10.5" Foreground="#7D8590"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- RIGHT COLUMN: Profile Photo, Name, Username, Folder, Shortcuts, Autostart -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Center" Margin="6,0,10,0">

                        <!-- Profile Photo Section with Editor Crop Trigger -->
                        <Border Background="#121620" BorderBrush="#1F2636" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar Preview Box -->
                                <Border Width="64" Height="64" CornerRadius="32" Background="#181F2C" BorderBrush="#38BDF8" BorderThickness="2"
                                        ClipToBounds="True" Cursor="Hand" MouseDown="AvatarBox_MouseDown">
                                    <Grid>
                                        <Image x:Name="AvatarPreviewImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                                        <TextBlock x:Name="AvatarPlaceholder" Text="📷" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="Фотография профиля" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,2"/>
                                    <TextBlock Text="Нажмите на фото для выбора и кадрирования под аватарку" FontSize="11" Foreground="#8B949E" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Выбрать и настроить фото..." Click="BtnPickAvatar_Click"
                                                Background="#1E2638" Foreground="#58A6FF" BorderBrush="#303E5C" BorderThickness="1"
                                                FontSize="11.5" Padding="10,4" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Name & Username (Login) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ваше имя:" FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,5"/>
                                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <TextBox x:Name="TxtDisplayName" Background="Transparent" Foreground="#E6EDF3"
                                             BorderThickness="0" FontSize="12.5" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Имя пользователя (@логин):" FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,5"/>
                                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <TextBox x:Name="TxtUsername" Background="Transparent" Foreground="#E6EDF3"
                                             BorderThickness="0" FontSize="12.5" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Installation Folder Selector -->
                        <StackPanel x:Name="PathPanel" Margin="0,0,0,12">
                            <TextBlock Text="Папка установки:" FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <TextBox x:Name="TxtInstallPath" Background="Transparent" Foreground="#E6EDF3"
                                             BorderThickness="0" FontSize="12" VerticalAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="1" x:Name="BtnBrowse" Content="Обзор..." Width="80" Height="32" Margin="8,0,0,0"
                                        Click="BtnBrowse_Click" Cursor="Hand" Background="#21262D" Foreground="#C9D1D9"
                                        BorderBrush="#30363D" BorderThickness="1" FontSize="12">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Installation Options Checkboxes -->
                        <StackPanel x:Name="OptionsPanel" Margin="0,0,0,4">
                            <CheckBox x:Name="ChkStartMenuShortcut" Content="Создать ярлык в меню Пуск"
                                      IsChecked="True" Foreground="#C9D1D9" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkDesktopShortcut" Content="Создать ярлык на рабочем столе"
                                      IsChecked="True" Foreground="#C9D1D9" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkAutostart" Content="Включить в автозапуск (запускать вместе с Windows)"
                                      IsChecked="False" Foreground="#C9D1D9" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkLaunchAfter" Content="Запустить Prime Messenger после завершения"
                                      IsChecked="True" Foreground="#C9D1D9"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Bottom Actions: Progress Bar on the left, Install button on the right at the SAME LEVEL -->
            <Border Grid.Row="2" Background="#121620" BorderBrush="#1F2636" BorderThickness="1" CornerRadius="12" Padding="14,10">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Text and Progress Bar -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitle" Text="Готово к установке"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#E6EDF3" Margin="0,0,0,3"/>
                        <ProgressBar x:Name="InstallProgress" Height="8" Minimum="0" Maximum="100" Value="0"
                                     Foreground="#4D9FFF" Background="#21262D" BorderThickness="0" Margin="0,0,0,3">
                            <ProgressBar.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                            </ProgressBar.Resources>
                        </ProgressBar>
                        <TextBlock x:Name="StatusSub" Text="Приложение сохранит ваш профиль и развернет все компоненты."
                                   FontSize="11" Foreground="#8B949E" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Install & Save Action Button -->
                    <Button Grid.Column="2" x:Name="InstallBtn" Content="Установить" Height="42" Width="170"
                            Click="InstallBtn_Click" Cursor="Hand"
                            Background="#4D9FFF" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"
                            BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
