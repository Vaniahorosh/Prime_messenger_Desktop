<Window x:Class="PrimeSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка Prime Desktop" Height="380" Width="480"
        Icon="Assets/prime.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#0F1117"
            BorderBrush="#252D3D"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title bar & logo -->
                <RowDefinition Height="*"/>    <!-- Content / Progress -->
                <RowDefinition Height="Auto"/> <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                        <Image Source="Assets/prime.ico" Width="24" Height="24" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock x:Name="HeaderTitle" Text="Prime Desktop" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock x:Name="HeaderSubtitle" Text="Установка версии v0.1 Desk для Windows" FontSize="12" Foreground="#8B949E"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="30" Height="30" Click="CloseButton_Click"
                        Background="Transparent" Foreground="#8B949E" BorderThickness="0"
                        FontSize="14" Cursor="Hand"/>
            </Grid>

            <!-- Content Area -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20,0,10">
                <TextBlock x:Name="StatusTitle" Text="Быстрая установка без лишних настроек" 
                           FontSize="15" FontWeight="SemiBold" Foreground="#E6EDF3" Margin="0,0,0,6"/>
                <TextBlock x:Name="StatusSub" Text="Приложение будет установлено в защищенную директорию пользователя." 
                           FontSize="12" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <ProgressBar x:Name="InstallProgress" Height="8" Minimum="0" Maximum="100" Value="0"
                             Foreground="#4D9FFF" Background="#21262D" BorderThickness="0" Margin="0,0,0,14"/>

                <!-- Options -->
                <CheckBox x:Name="ChkDesktopShortcut" Content="Создать ярлык на рабочем столе" 
                          IsChecked="True" Foreground="#C9D1D9" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkLaunchAfter" Content="Запустить Prime Messenger после завершения" 
                          IsChecked="True" Foreground="#C9D1D9"/>
            </StackPanel>

            <!-- Bottom Actions -->
            <Grid Grid.Row="2">
                <Button x:Name="InstallBtn" Content="Установить в 1 клик" Height="42" 
                        Click="InstallBtn_Click" Cursor="Hand"
                        Background="#4D9FFF" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>