<Window x:Class="PrimeDesktop.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:vm="clr-namespace:PrimeDesktop.ViewModels"

        xmlns:conv="clr-namespace:PrimeDesktop.Converters"
        xmlns:controls="clr-namespace:PrimeDesktop.Controls"

        Title="Prime Desktop" Icon="Assets/prime.ico" Height="720" Width="1100"

        MinHeight="550" MinWidth="850"

        WindowStartupLocation="CenterScreen"

        WindowStyle="None" AllowsTransparency="False"

        Background="{DynamicResource BackgroundBrush}">



    <WindowChrome.WindowChrome>

        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>

    </WindowChrome.WindowChrome>



    <Window.DataContext>

        <vm:MainViewModel/>

    </Window.DataContext>



    <Window.Resources>

        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <conv:ConnectionStateColorConverter x:Key="StateColorConverter"/>

        <conv:HexToBrushConverter x:Key="HexToBrush"/>

        <conv:MessageAlignmentConverter x:Key="MsgAlignConverter"/>

        <conv:MessageBubbleBrushConverter x:Key="MsgBubbleConverter"/>

        <conv:NullToVisibilityConverter x:Key="NullToVis"/>

        <conv:NotNullToVisibilityConverter x:Key="NotNullToVis"/>

        <conv:EqualityToVisibilityConverter x:Key="EqualityToVis"/>
        <conv:NonLockingImageConverter x:Key="NonLockingImgConverter"/>
        <conv:InitialsConverter x:Key="InitialsConverter"/>

        <conv:ReactionSelectedBackgroundConverter x:Key="ReactionSelectedBgConverter"/>
        <conv:ReactionSelectedBorderConverter x:Key="ReactionSelectedBorderConverter"/>
        <conv:ReactionCountBrushConverter x:Key="ReactionCountBrushConverter"/>

        <Style x:Key="ReactionChipButton" TargetType="Button">
            <Setter Property="Background" Value="{Binding IsSelectedByMe, Converter={StaticResource ReactionSelectedBgConverter}}" />
            <Setter Property="BorderBrush" Value="{Binding IsSelectedByMe, Converter={StaticResource ReactionSelectedBorderConverter}}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Margin" Value="0,0,5,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChipBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>



    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="36"/> <!-- Custom TitleBar -->

            <RowDefinition Height="*"/>  <!-- Main Content -->

        </Grid.RowDefinitions>



        <!-- Custom Windows 11 TitleBar -->

        <Grid Grid.Row="0" Background="{DynamicResource HeaderBrush}" MouseLeftButtonDown="TitleBar_MouseDown">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>



            <!-- App Title & Official Prime Logo -->

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">

                <Image Source="Assets/prime_logo_app.png" Width="22" Height="22" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>

                <TextBlock Text="ПРАЙМ" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold"/>

            </StackPanel>



            <!-- Window Control Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnMinimize"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="Свернуть"
                        Click="BtnMinimize_Click">
                    <Path Width="10" Height="1" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True" Data="M 0,0.5 H 10"/>
                </Button>

                <Button x:Name="BtnMaximize"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="Развернуть"
                        Click="BtnMaximize_Click">
                    <Grid>
                        <!-- Maximize icon (square) -->
                        <Path x:Name="IconMaximize" Width="10" Height="10" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" Visibility="Visible"/>
                        <!-- Restore icon (overlapping squares) -->
                        <Path x:Name="IconRestore" Width="10" Height="10" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True" Data="M 2.5,0.5 H 9.5 V 7.5 H 7.5 M 0.5,2.5 H 7.5 V 9.5 H 0.5 Z" Visibility="Collapsed"/>
                    </Grid>
                </Button>

                <Button x:Name="BtnClose"
                        Style="{StaticResource CloseCaptionButtonStyle}"
                        ToolTip="Закрыть в трей"
                        Click="BtnClose_Click">
                    <Path Width="10" Height="10" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True" Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
                </Button>
            </StackPanel>

        </Grid>



        <!-- 5-Column Main Layout Grid (with interactive GridSplitters) -->

        <Grid Grid.Row="1" x:Name="MainContentGrid">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="72" MaxWidth="450"/> <!-- Col 0: Sidebar (can shrink to 72px for avatar rail) -->
                <ColumnDefinition Width="Auto"/>                             <!-- Col 1: Splitter 1 -->
                <ColumnDefinition Width="*"/>                                <!-- Col 2: Chat View -->
                <ColumnDefinition Width="Auto"/>                             <!-- Col 3: Splitter 2 -->
                <ColumnDefinition x:Name="ColDrawer" MaxWidth="850">                            <!-- Col 4: Profile & Info Drawer -->
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="330"/>
                            <Setter Property="MinWidth" Value="280"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMediaDrawerOpen}" Value="False">
                                    <Setter Property="Width" Value="0"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>



            <!-- Column 0: Left Sidebar -->

            <Border Grid.Column="0" ClipToBounds="True" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header & Morphing Search Bar -->
                        <RowDefinition Height="*"/>    <!-- Chats List -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
                    </Grid.RowDefinitions>

                    <!-- Header with Morphing Search Bar -->
                    <Grid Grid.Row="0" Margin="14,14,14,10" Height="40" ClipToBounds="True">
                        <!-- Left Items Group: Avatar + Name + Discovery Button (slides left and fades out) -->
                        <DockPanel x:Name="LeftSlidingGroup" Margin="0,0,42,0" VerticalAlignment="Center">
                            <DockPanel.RenderTransform>
                                <TranslateTransform x:Name="LeftGroupTransform" X="0"/>
                            </DockPanel.RenderTransform>

                            <!-- Discovery Button ("Поиск устройств Prime") -->
                            <Button x:Name="BtnDeviceDiscovery" Style="{StaticResource ModernButton}" 
                                    ToolTip="Поиск устройств Prime" Command="{Binding OpenDeviceDiscoveryCommand}" 
                                    DockPanel.Dock="Right" Width="34" Height="34" Padding="0">
                                <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource TextSecondaryBrush}" Width="15" Height="15" Stretch="Uniform"/>
                            </Button>

                            <!-- Left: Profile Avatar & Name (Click to open settings) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" ToolTip="Настройки профиля">
                                <StackPanel.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleSettingsCommand}"/>
                                </StackPanel.InputBindings>

                                <Border Width="38" Height="38" CornerRadius="{Binding AvatarCornerRadius}" 
                                        Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="{Binding Settings.MyDisplayName, Converter={StaticResource InitialsConverter}}"
                                                   Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Settings.MyAvatarPath, Converter={StaticResource NullToVis}}"/>

                                        <Border CornerRadius="{Binding AvatarCornerRadius}"
                                                Visibility="{Binding Settings.MyAvatarPath, Converter={StaticResource NotNullToVis}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Settings.MyAvatarPath, Converter={StaticResource NonLockingImgConverter}}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Settings.MyDisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Настройки" Foreground="{DynamicResource AccentBrush}" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- Search Morph Bar (Anchored at Right, expands from 34px to full width) -->
                        <Border x:Name="SearchMorphContainer" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                Height="36" Width="34" CornerRadius="18"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                ClipToBounds="True">
                            <Grid>
                                <!-- Collapsed Button State: Click to expand -->
                                <Button x:Name="BtnSearchTrigger" Style="{StaticResource ModernButton}" 
                                        Command="{Binding OpenSearchCommand}" ToolTip="Поиск" 
                                        Background="Transparent" BorderThickness="0"
                                        Width="34" Height="34" Padding="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource TextSecondaryBrush}" Width="15" Height="15" Stretch="Uniform"/>
                                </Button>

                                <!-- Expanded Bar State: Search Icon, TextBox, Close Button (✕) -->
                                <Grid x:Name="SearchActiveControls" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                      Opacity="0" IsHitTestVisible="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Search Icon at left of input -->
                                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{DynamicResource TextSecondaryBrush}" 
                                          Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

                                    <!-- Clean Search Input: standard caret, no invisible padding/margins! -->
                                    <TextBox Grid.Column="1" x:Name="SearchTextBox" 
                                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             FontSize="13" VerticalContentAlignment="Center"
                                             Padding="0"
                                             FocusVisualStyle="{x:Null}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Esc" Command="{Binding CloseSearchCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <!-- Close Button (✕) at right of input -->
                                    <Button Grid.Column="2" x:Name="BtnSearchClose" Style="{StaticResource ModernButton}" 
                                            Command="{Binding CloseSearchCommand}" ToolTip="Закрыть поиск (Esc)" 
                                            Width="28" Height="28" Padding="0"
                                            Content="✕" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                            Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Button.RenderTransform>
                                            <ScaleTransform x:Name="CloseBtnScale" ScaleX="0.4" ScaleY="0.4"/>
                                        </Button.RenderTransform>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Chats List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredChats}" SelectedItem="{Binding SelectedChat}"

                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Padding="10,8" Margin="6,2" CornerRadius="8" Background="Transparent"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">

                                    <Border.ContextMenu>
                                        <ContextMenu Style="{StaticResource ModernContextMenu}">
                                            <MenuItem Header="🔕 Отключить уведомления"
                                                      Style="{StaticResource ModernMenuItem}"
                                                      Command="{Binding PlacementTarget.Tag.ToggleMuteChatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Visibility="{Binding PlacementTarget.DataContext.IsMuted, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"/>
                                            <MenuItem Header="🔔 Включить уведомления"
                                                      Style="{StaticResource ModernMenuItem}"
                                                      Command="{Binding PlacementTarget.Tag.ToggleMuteChatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Visibility="{Binding PlacementTarget.DataContext.IsMuted, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"/>
                                            <Separator Background="#223145" Margin="4,3"/>
                                            <MenuItem Header="🗑️ Удалить этот чат"
                                                      Style="{StaticResource DangerMenuItem}"
                                                      Command="{Binding PlacementTarget.Tag.DeleteChatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto"/>

                                            <ColumnDefinition Width="*" MinWidth="0"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>



                                        <!-- Avatar with State Dot -->

                                        <Grid Grid.Column="0" Margin="0,0,10,0">

                                            <Border Width="42" Height="42" CornerRadius="{Binding DataContext.AvatarCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}" Background="{DynamicResource CardBrush}">

                                                <Grid>

                                                    <TextBlock Text="{Binding Initials}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"

                                                               Visibility="{Binding HasAvatar, Converter={StaticResource InverseBoolToVis}}"/>

                                                    <Border CornerRadius="{Binding DataContext.AvatarCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}">

                                                        <Border.Background>

                                                            <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource NonLockingImgConverter}}" Stretch="UniformToFill"/>

                                                        </Border.Background>

                                                    </Border>

                                                </Grid>

                                            </Border>

                                            <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"

                                                     Fill="{Binding StatusColorHex, Converter={StaticResource HexToBrush}}"
                                                     Visibility="{Binding IsOnlineIndicatorVisible, Converter={StaticResource BoolToVis}}"/>

                                        </Grid>



                                        <!-- Name & Last Message -->

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Text="{Binding LastMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>

                                        </StackPanel>



                                        <!-- Time & Unread Badge -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Path Data="{StaticResource IconBellOff}" Fill="{StaticResource TextMutedBrush}" Width="10" Height="10" Stretch="Uniform"
                                                      Margin="0,0,4,0" VerticalAlignment="Center"
                                                      Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}" ToolTip="Уведомления отключены"/>
                                                <TextBlock Text="{Binding LastMessageTime}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                            </StackPanel>
                                            <Border Background="{StaticResource BadgeBrush}" CornerRadius="10" MinWidth="18" Height="18" Margin="0,4,0,0"
                                                    Visibility="{Binding UnreadCount, Converter={StaticResource BoolToVis}}">
                                                <controls:AnimatedTextTransitionControl Text="{Binding UnreadCount}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                            </Border>
                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>



                    <!-- Status Bar -->
                    <Border Grid.Row="2" Background="{DynamicResource HeaderBrush}" Padding="12,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">

                        <controls:AnimatedTextTransitionControl Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>

                    </Border>

                </Grid>

            </Border>

            <!-- Column 1: GridSplitter 1 -->

            <GridSplitter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"

                          ResizeBehavior="PreviousAndNext" Width="5" Cursor="SizeWE"

                          Background="{DynamicResource BorderBrush}" Opacity="0.5"/>



            <!-- Column 2: Chat View -->

            <Grid Grid.Column="2" Background="{DynamicResource BackgroundBrush}">

                <!-- Active Chat Content -->

                <Grid Visibility="{Binding HasSelectedChat, Converter={StaticResource BoolToVis}}">

                <Grid.RowDefinitions>

                    <RowDefinition Height="60"/> <!-- Chat Header -->

                    <RowDefinition Height="*"/>  <!-- Messages Scroll Area -->

                    <RowDefinition Height="Auto"/> <!-- Reply Bar & Input Area (Step 4) -->

                </Grid.RowDefinitions>



                <!-- Chat Header -->

                <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">

                    <DockPanel VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Style="{StaticResource ModernButton}" Command="{Binding ToggleMuteChatCommand}" CommandParameter="{Binding SelectedChat}"
                                    ToolTip="Включить / отключить уведомления" Width="36" Height="34" Padding="0" Margin="0,0,6,0">
                                <Grid>
                                    <Path Data="{StaticResource IconBell}" Fill="{StaticResource TextMutedBrush}" Width="15" Height="15" Stretch="Uniform"
                                          Visibility="{Binding SelectedChat.IsMuted, Converter={StaticResource InverseBoolToVis}}"/>
                                    <Path Data="{StaticResource IconBellOff}" Fill="#FF6B6B" Width="15" Height="15" Stretch="Uniform"
                                          Visibility="{Binding SelectedChat.IsMuted, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Button>
                            <Button Content="ℹ" Style="{StaticResource ModernButton}" Command="{Binding ToggleMediaDrawerCommand}" ToolTip="Профиль и медиа" Width="36" Height="34" Padding="0" Margin="0,0,6,0"/>
                            <Button x:Name="BtnChatHeaderMore" Style="{StaticResource ModernButton}" ToolTip="Действия с чатом" Width="36" Height="34" Padding="0" Click="BtnChatHeaderMore_Click">
                                <Path Data="{StaticResource IconMoreVertical}" Fill="{StaticResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform"/>
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource ModernContextMenu}">
                                        <MenuItem Header="🔕 Отключить уведомления"
                                                  Style="{StaticResource ModernMenuItem}"
                                                  Command="{Binding ToggleMuteChatCommand}" CommandParameter="{Binding SelectedChat}"
                                                  Visibility="{Binding SelectedChat.IsMuted, Converter={StaticResource InverseBoolToVis}}"/>
                                        <MenuItem Header="🔔 Включить уведомления"
                                                  Style="{StaticResource ModernMenuItem}"
                                                  Command="{Binding ToggleMuteChatCommand}" CommandParameter="{Binding SelectedChat}"
                                                  Visibility="{Binding SelectedChat.IsMuted, Converter={StaticResource BoolToVis}}"/>
                                        <MenuItem Header="ℹ Профиль и медиа"
                                                  Style="{StaticResource ModernMenuItem}"
                                                  Command="{Binding ToggleMediaDrawerCommand}"/>
                                        <Separator Background="#223145" Margin="4,3"/>
                                        <MenuItem Header="🗑️ Удалить чат"
                                                  Style="{StaticResource DangerMenuItem}"
                                                  Command="{Binding DeleteSelectedChatCommand}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <Border Width="38" Height="38" CornerRadius="{Binding HeaderAvatarCornerRadius}" Background="{DynamicResource CardBrush}" Margin="0,0,12,0">

                                <Grid>

                                    <TextBlock Text="{Binding SelectedChat.Initials}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"

                                               Visibility="{Binding SelectedChat.HasAvatar, Converter={StaticResource InverseBoolToVis}}"/>

                                    <Border CornerRadius="{Binding HeaderAvatarCornerRadius}" Visibility="{Binding SelectedChat.HasAvatar, Converter={StaticResource BoolToVis}}">

                                        <Border.Background>

                                            <ImageBrush ImageSource="{Binding SelectedChat.AvatarPath, Converter={StaticResource NonLockingImgConverter}}" Stretch="UniformToFill"/>

                                        </Border.Background>

                                    </Border>

                                </Grid>

                            </Border>

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="{Binding SelectedChat.DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14"/>

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">

                                    <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center"
                                             Fill="{Binding SelectedChat.StatusColorHex, Converter={StaticResource HexToBrush}}"
                                             Visibility="{Binding SelectedChat.IsOnlineIndicatorVisible, Converter={StaticResource BoolToVis}}"/>

                                    <controls:AnimatedTextTransitionControl Text="{Binding SelectedChat.StatusText}"
                                               Foreground="{Binding SelectedChat.StatusColorHex, Converter={StaticResource HexToBrush}}"
                                               FontSize="11" FontWeight="SemiBold"/>

                                </StackPanel>

                            </StackPanel>

                        </StackPanel>

                    </DockPanel>

                </Border>



                <!-- Wallpaper Background Layer -->

                <Image Grid.Row="1" Source="{Binding Settings.ChatWallpaperPath}" Stretch="UniformToFill"

                       Opacity="{Binding Settings.WallpaperOpacity}"

                       Visibility="{Binding Settings.HasWallpaper, Converter={StaticResource BoolToVis}}"

                       IsHitTestVisible="False"/>



                <!-- Messages Scroll Area with Hardware-Accelerated Virtualization -->
                <ScrollViewer Grid.Row="1" x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto" Padding="16"
                              AllowDrop="True" Drop="ChatArea_Drop" DragOver="ChatArea_DragOver"
                              CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel">
                    <ItemsControl ItemsSource="{Binding SelectedChat.Messages}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <StackPanel HorizontalAlignment="Stretch">

                                    <!-- Centered Date Header Pill matching Android layout_date_header -->
                                    <Border HorizontalAlignment="Center" Margin="0,8,0,6"
                                            Background="#182230" BorderBrush="#26364A" BorderThickness="1"
                                            CornerRadius="12" Padding="12,4"
                                            Visibility="{Binding ShowDateHeader, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding DateHeaderText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>

                                    <Grid Margin="0,2" HorizontalAlignment="{Binding IsFromMe, Converter={StaticResource MsgAlignConverter}}">

                                    <Grid.RenderTransform>

                                        <TranslateTransform Y="0"/>

                                    </Grid.RenderTransform>

                                    <Grid.Style>

                                        <Style TargetType="Grid">

                                            <Style.Triggers>

                                                <EventTrigger RoutedEvent="Loaded">

                                                    <BeginStoryboard>

                                                        <Storyboard>

                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.22">

                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>

                                                            </DoubleAnimation>

                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.22">

                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>

                                                            </DoubleAnimation>

                                                        </Storyboard>

                                                    </BeginStoryboard>

                                                </EventTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Grid.Style>

                                    <StackPanel>

                                        <Border Background="{Binding IsFromMe, Converter={StaticResource MsgBubbleConverter}}"

                                            CornerRadius="{Binding DataContext.BubbleCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}" Padding="{Binding BubblePadding}" MaxWidth="520"

                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"

                                            ContextMenuOpening="MessageBorder_ContextMenuOpening">

                                        <Border.InputBindings>

                                            <MouseBinding Gesture="LeftDoubleClick"

                                                          Command="{Binding DataContext.QuickReactionCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                                          CommandParameter="{Binding}"/>

                                        </Border.InputBindings>

                                        <Border.ContextMenu>
                                            <ContextMenu Style="{StaticResource ModernContextMenu}">
                                                <!-- Reaction Island (Top row of 8 emojis + expand button) -->
                                                <Border Background="#0C131D" BorderBrush="#1F2C3F" BorderThickness="1" CornerRadius="12" Padding="6,4" Margin="2,2,2,6">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="👍" Style="{StaticResource ReactionEmojiButton}"
                                                                Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                Command="{Binding PlacementTarget.Tag.SetReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                CommandParameter="👍" Click="ReactionButton_Click"/>
                                                        <Button Content="❤️" Style="{StaticResource ReactionEmojiButton}"
                                                                Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                Command="{Binding PlacementTarget.Tag.SetReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                CommandParameter="❤️" Click="ReactionButton_Click"/>
                                                        <Button Content="🔥" Style="{StaticResource ReactionEmojiButton}"
                                                                Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                Command="{Binding PlacementTarget.Tag.SetReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                CommandParameter="🔥" Click="ReactionButton_Click"/>
                                                        <Button Content="😂" Style="{StaticResource ReactionEmojiButton}"
                                                                Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                Command="{Binding PlacementTarget.Tag.SetReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                CommandParameter="😂" Click="ReactionButton_Click"/>
                                                        <Button Content="😮" Style="{StaticResource ReactionEmojiButton}"
                                                                Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                Command="{Binding PlacementTarget.Tag.SetReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                CommandParameter="😮" Click="ReactionButton_Click"/>
                                                        <Button Content="😢" Style="{StaticResource ReactionEmojiButton}"
                                                                Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                Command="{Binding PlacementTarget.Tag.SetReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                CommandParameter="😢" Click="ReactionButton_Click"/>
                                                        <Button Content="🎉" Style="{StaticResource ReactionEmojiButton}"
                                                                Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                Command="{Binding PlacementTarget.Tag.SetReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                CommandParameter="🎉" Click="ReactionButton_Click"/>
                                                        <Button Content="➕" Style="{StaticResource ReactionEmojiButton}"
                                                                Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                Click="BtnExpandReactions_Click" ToolTip="Все реакции..."/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Actions -->
                                                <MenuItem Header="↩️ Ответить"
                                                          Style="{StaticResource ModernMenuItem}"
                                                          Command="{Binding PlacementTarget.Tag.ReplyToMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="📋 Копировать"
                                                          Style="{StaticResource ModernMenuItem}"
                                                          Command="{Binding PlacementTarget.Tag.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="↗️ Переслать"
                                                          Style="{StaticResource ModernMenuItem}"
                                                          Command="{Binding PlacementTarget.Tag.ForwardMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="✏️ Редактировать"
                                                          Style="{StaticResource ModernMenuItem}"
                                                          Command="{Binding PlacementTarget.Tag.EditMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          Visibility="{Binding PlacementTarget.DataContext.IsFromMe, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"/>
                                                <Separator Background="#223145" Margin="4,3"
                                                           Visibility="{Binding PlacementTarget.DataContext.IsFromMe, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"/>
                                                <MenuItem Header="🗑️ Удалить"
                                                          Style="{StaticResource DangerMenuItem}"
                                                          Command="{Binding PlacementTarget.Tag.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          Visibility="{Binding PlacementTarget.DataContext.IsFromMe, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <StackPanel>

                                            <!-- Quoted Reply Banner -->

                                            <Border Background="#20FFFFFF" CornerRadius="6" Padding="8,4" Margin="0,0,0,6"

                                                    Visibility="{Binding HasReply, Converter={StaticResource BoolToVis}}">

                                                <StackPanel>

                                                    <TextBlock Text="{Binding ReplyToSender}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>

                                                    <TextBlock Text="{Binding ReplyToText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>

                                                </StackPanel>

                                            </Border>



                                            <!-- File Attachment Card -->

                                            <Border Background="#20000000" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,6"

                                                    Cursor="Hand" Visibility="{Binding HasFileAttachmentCard, Converter={StaticResource BoolToVis}}">

                                                <Border.InputBindings>

                                                    <MouseBinding Gesture="LeftClick"

                                                                  Command="{Binding DataContext.OpenFileAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                                                  CommandParameter="{Binding}"/>

                                                </Border.InputBindings>

                                                <Grid>

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="Auto"/>

                                                        <ColumnDefinition Width="*"/>

                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="#25FFFFFF" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding FileIcon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="280"/>

                                                        <TextBlock Text="{Binding FormattedFileSize}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0"/>

                                                    </StackPanel>

                                                </Grid>

                                            </Border>



                                            <!-- Voice Message Player Banner -->
                                            <Border Background="#25000000" CornerRadius="10" Padding="10,8" Margin="0,0,0,6"
                                                    Visibility="{Binding IsVoice, Converter={StaticResource BoolToVis}}"
                                                    MinWidth="230">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Play / Pause Circular Button -->
                                                    <Button Grid.Column="0"
                                                            Command="{Binding DataContext.PlayVoiceMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ModernButton}" Width="36" Height="36" Padding="0" Margin="0,0,10,0">
                                                        <Grid>
                                                            <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentBrush}" Opacity="0.18"/>
                                                            <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform"
                                                                  Margin="2,0,0,0"
                                                                  Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Path Data="{StaticResource IconPause}" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform"
                                                                  Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Button>

                                                    <!-- Waveform & Duration Display -->
                                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <controls:WaveformVisualizer Grid.Row="0"
                                                                                    Waveform="{Binding Waveform}"
                                                                                    Progress="{Binding PlaybackProgress}"
                                                                                    SeekCommand="{Binding DataContext.SeekVoiceMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    MessageContext="{Binding}"
                                                                                    PlayedBrush="{DynamicResource AccentBrush}"
                                                                                    UnplayedBrush="#55FFFFFF"
                                                                                    Height="24"
                                                                                    VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding DisplayPlayTime}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Margin="0,2,0,0"/>
                                                    </Grid>

                                                    <!-- Playback Speed Toggle (1x, 1.5x, 2x) -->
                                                    <Border Grid.Column="2" CornerRadius="10" Background="#28FFFFFF" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource ModernButton}"
                                                                Command="{Binding DataContext.ToggleVoiceSpeedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="6,2" Height="22"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                ToolTip="Скорость воспроизведения (1x, 1.5x, 2x)">
                                                            <TextBlock Text="{Binding SpeedText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                        </Button>
                                                    </Border>
                                                </Grid>
                                            </Border>



                                            <!-- Single Photo Attachment Preview -->

                                            <Border CornerRadius="8" Margin="0,0,0,6" MaxHeight="280" ClipToBounds="True" Cursor="Hand"

                                                    Visibility="{Binding IsSinglePhoto, Converter={StaticResource BoolToVis}}">

                                                <Border.InputBindings>

                                                    <MouseBinding Gesture="LeftClick"

                                                                  Command="{Binding DataContext.OpenPhotoViewerCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                                                  CommandParameter="{Binding FilePath}"/>

                                                </Border.InputBindings>

                                                <Image Source="{Binding FilePath}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

                                            </Border>



                                            <!-- Collage / Multi-Photo Attachment Preview -->

                                            <Border CornerRadius="8" Margin="0,0,0,6" ClipToBounds="True" MaxWidth="360"

                                                    Visibility="{Binding IsCollage, Converter={StaticResource BoolToVis}}">

                                                <ItemsControl ItemsSource="{Binding CollagePaths}">

                                                    <ItemsControl.ItemsPanel>

                                                        <ItemsPanelTemplate>

                                                            <UniformGrid Columns="2"/>

                                                        </ItemsPanelTemplate>

                                                    </ItemsControl.ItemsPanel>

                                                    <ItemsControl.ItemTemplate>

                                                        <DataTemplate>

                                                            <Border CornerRadius="6" Margin="2" Height="130" ClipToBounds="True" Cursor="Hand" Background="#1A222D">

                                                                <Border.InputBindings>

                                                                    <MouseBinding Gesture="LeftClick"

                                                                                  Command="{Binding DataContext.OpenPhotoViewerCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                                                                  CommandParameter="{Binding}"/>

                                                                </Border.InputBindings>

                                                                <Image Source="{Binding}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>

                                                            </Border>

                                                        </DataTemplate>

                                                    </ItemsControl.ItemTemplate>

                                                </ItemsControl>

                                            </Border>



                                            <!-- Single Video Looping Preview -->
                                            <controls:VideoPreviewPlayer Source="{Binding FilePath}"
                                                                        Duration="{Binding Duration}"
                                                                        ClickCommand="{Binding DataContext.OpenPhotoViewerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        ClickCommandParameter="{Binding FilePath}"
                                                                        Margin="0,0,0,6"
                                                                        Visibility="{Binding IsSingleVideo, Converter={StaticResource BoolToVis}}"/>

                                            <!-- Message Text with Rich Formatting & Clickable Links -->
                                            <controls:FormattedMessageTextBlock RawText="{Binding DisplayText}"
                                                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                FontSize="{Binding MessageFontSize}"
                                                                                TextWrapping="Wrap"
                                                                                Margin="6,4,6,4"
                                                                                Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}"/>

                                            <!-- OpenGraph Link Preview Card matching Android layout_link_preview -->
                                            <Border Background="#16202E" BorderBrush="#2C3D56" BorderThickness="1" CornerRadius="8"
                                                    Padding="8" Margin="4,2,4,4" Cursor="Hand"
                                                    Visibility="{Binding HasLinkPreview, Converter={StaticResource BoolToVis}}"
                                                    MouseLeftButtonUp="LinkPreviewCard_MouseLeftButtonUp"
                                                    Tag="{Binding LinkPreview.Url}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6" ClipToBounds="True"
                                                            Margin="0,0,10,0" Background="#0F1622"
                                                            Visibility="{Binding LinkPreview.HasImage, Converter={StaticResource BoolToVis}}">
                                                        <Image Source="{Binding LinkPreview.LocalImagePath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LinkPreview.Domain}" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding LinkPreview.Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding LinkPreview.Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                                   Visibility="{Binding LinkPreview.HasDescription, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>



                                            <!-- Video Note Circle Playback (Param 11) -->
                                            <controls:VideoNotePlayer Source="{Binding VideoNotePath}"
                                                                      Duration="{Binding Duration}"
                                                                      CornerRadius="{Binding VideoNoteCornerRadius}"
                                                                      Margin="0,0,0,6"
                                                                      Visibility="{Binding IsVideoNote, Converter={StaticResource BoolToVis}}"/>



                                            <!-- Time & Delivery Status Ticks -->

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">

                                                <!-- Rich Formatting Badge "Ф" matching Android -->
                                                <Border Background="#1C2E4A" CornerRadius="4" Padding="3,1" Margin="0,0,5,0" VerticalAlignment="Center"
                                                        ToolTip="Расширенное форматирование"
                                                        Visibility="{Binding IsRich, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Ф" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                </Border>

                                                <TextBlock Text="изм." Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center"

                                                           Visibility="{Binding IsEdited, Converter={StaticResource BoolToVis}}"/>

                                                <TextBlock Text="{Binding FormattedTime}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"/>

                                                <TextBlock Text="{Binding StatusTick}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="4,0,0,0" FontWeight="Bold" VerticalAlignment="Center"/>

                                            </StackPanel>

                                        </StackPanel>

                                    </Border>



                                    <!-- Floating Reaction Pills: multiple emoji chips with counts and user highlight -->
                                    <ItemsControl ItemsSource="{Binding ReactionGroups}"
                                                  HorizontalAlignment="{Binding IsFromMe, Converter={StaticResource MsgAlignConverter}}"
                                                  Margin="6,-10,6,2"
                                                  Visibility="{Binding HasReactions, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ReactionChipButton}"
                                                        Tag="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext}"
                                                        Click="ReactionChip_Click"
                                                        ToolTip="{Binding Tooltip}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Emoji}" FontSize="13" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="{Binding IsSelectedByMe, Converter={StaticResource ReactionCountBrushConverter}}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>

                                </Grid>

                                </StackPanel>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

                <!-- Floating Scroll-To-Bottom FAB Button matching Android btnScrollToBottom -->
                <Button Grid.Row="1" x:Name="BtnScrollToBottom"
                        Width="40" Height="40"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,24,20"
                        Cursor="Hand"
                        Click="BtnScrollToBottom_Click"
                        Visibility="Collapsed"
                        ToolTip="Прокрутить вниз">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#24344D" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                                    CornerRadius="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.4"/>
                                </Border.Effect>
                                <Path Data="{StaticResource IconChevronDown}" Fill="{DynamicResource AccentBrush}"
                                      Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2F4465"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Row 2: Reply Bar & Message Input Area -->

                <Border Grid.Row="2" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,10"
                        Visibility="{Binding IsReadingMode, Converter={StaticResource InverseBoolToVis}}">

                    <StackPanel>

                        <!-- Active Edit Banner -->

                        <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,8"

                                Visibility="{Binding IsEditingMessage, Converter={StaticResource BoolToVis}}">

                            <DockPanel>

                                <Button Content="✕" Style="{StaticResource ModernButton}" Command="{Binding CancelEditCommand}" DockPanel.Dock="Right" Width="24" Height="24" Padding="0"/>

                                <StackPanel>

                                    <TextBlock Text="Редактирование сообщения:" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding EditingMessage.Text}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>

                                </StackPanel>

                            </DockPanel>

                        </Border>



                        <!-- Active Reply Banner -->

                        <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,8"

                                Visibility="{Binding HasReply, Converter={StaticResource BoolToVis}}">

                            <DockPanel>

                                <Button Content="✕" Style="{StaticResource ModernButton}" Command="{Binding CancelReplyCommand}" DockPanel.Dock="Right" Width="24" Height="24" Padding="0"/>

                                <StackPanel>

                                    <TextBlock Text="Ответ на сообщение:" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding ReplyMessage.Text}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>

                                </StackPanel>

                            </DockPanel>

                        </Border>

                        <!-- Staged Pending Attachment Banner (Matches mobile preview with caption) -->
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                                Visibility="{Binding HasPendingAttachment, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button Content="✕" Style="{StaticResource ModernButton}" Command="{Binding CancelPendingAttachmentCommand}" DockPanel.Dock="Right" Width="26" Height="26" Padding="0" ToolTip="Отменить вложение"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Thumbnail preview if image / collage -->
                                    <Border Width="44" Height="44" CornerRadius="6" Margin="0,0,10,0" Background="#1A2230" ClipToBounds="True">
                                        <Grid>
                                            <!-- If photo or collage, show image thumbnail -->
                                            <Image Source="{Binding PendingAttachment.PrimaryFilePath}" Stretch="UniformToFill"
                                                   Visibility="{Binding PendingAttachment.HasImageThumbnail, Converter={StaticResource BoolToVis}}"/>
                                            <!-- If file, show file icon -->
                                            <TextBlock Text="{Binding PendingAttachment.Icon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding PendingAttachment.HasImageThumbnail, Converter={StaticResource InverseBoolToVis}}"/>
                                            <!-- If collage badge -->
                                            <Border Background="#CC000000" CornerRadius="4" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2"
                                                    Visibility="{Binding PendingAttachment.IsCollage, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding PendingAttachment.FilePaths.Count, StringFormat='{}✕{0}'}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PendingAttachment.Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                        <TextBlock Text="{Binding PendingAttachment.Subtitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Rich Formatting Toolbar for Desktop (Toggleable) -->
                        <Border Background="#141E2C" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Padding="8,4" Margin="0,0,0,6"
                                Visibility="{Binding IsRichFormattingActive, Converter={StaticResource BoolToVis}}">
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Button Style="{StaticResource ModernButton}" Width="30" Height="26" Margin="1,0" ToolTip="Жирный (Ctrl+B)" Command="{Binding InsertRichFormatCommand}" CommandParameter="B">
                                        <TextBlock Text="B" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                    </Button>
                                    <Button Style="{StaticResource ModernButton}" Width="30" Height="26" Margin="1,0" ToolTip="Курсив (Ctrl+I)" Command="{Binding InsertRichFormatCommand}" CommandParameter="I">
                                        <TextBlock Text="I" FontStyle="Italic" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                    </Button>
                                    <Button Style="{StaticResource ModernButton}" Width="30" Height="26" Margin="1,0" ToolTip="Заголовок" Command="{Binding InsertRichFormatCommand}" CommandParameter="H">
                                        <TextBlock Text="H" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                                    </Button>
                                    <Button Style="{StaticResource ModernButton}" Width="30" Height="26" Margin="1,0" ToolTip="Цитата" Command="{Binding InsertRichFormatCommand}" CommandParameter="Quote">
                                        <TextBlock Text="❝" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                    </Button>
                                    <Button Style="{StaticResource ModernButton}" Width="30" Height="26" Margin="1,0" ToolTip="Код" Command="{Binding InsertRichFormatCommand}" CommandParameter="Code">
                                        <TextBlock Text="&lt;/&gt;" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                    </Button>
                                    <Button Style="{StaticResource ModernButton}" Width="30" Height="26" Margin="1,0" ToolTip="Таблица" Command="{Binding InsertRichFormatCommand}" CommandParameter="Table">
                                        <TextBlock Text="⊞" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                    </Button>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource ModernButton}" Height="24" Padding="6,0" ToolTip="Закрыть панель форматирования" Command="{Binding ToggleRichFormattingCommand}">
                                    <TextBlock Text="✕ Закрыть" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                </Button>
                            </DockPanel>
                        </Border>

                        <!-- Input Controls Row -->

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/> <!-- Attachments -->

                                <ColumnDefinition Width="*"/>    <!-- Text Box -->

                                <ColumnDefinition Width="Auto"/> <!-- Send Button -->

                            </Grid.ColumnDefinitions>



                            <!-- Unified Attachment Button & Custom Designer Tray -->
                            <Grid Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                <ToggleButton x:Name="AttachTrayToggle"
                                              IsChecked="{Binding IsAttachmentTrayOpen, Mode=TwoWay}"
                                              Style="{StaticResource RoundIconToggleButton}"
                                              ToolTip="Прикрепить (Медиа, Файл, GIF)"
                                              Width="36" Height="36">
                                    <Path Data="{StaticResource IconAttach}"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Width="16" Height="16" Stretch="Uniform"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAttachmentTrayOpen}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </ToggleButton>

                                <Popup IsOpen="{Binding IsAttachmentTrayOpen, Mode=TwoWay}"
                                       StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=AttachTrayToggle}"
                                       Placement="Top"
                                       VerticalOffset="-10"
                                       HorizontalOffset="-4"
                                       AllowsTransparency="True">
                                    <Border Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="6,6">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#000000"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- 1. Медиа (фото и видео) -->
                                            <Button Style="{StaticResource ModernTrayItemButton}"
                                                    Command="{Binding AttachPhotoCommand}"
                                                    ToolTip="Отправить фото или видео (коллаж)">
                                                <StackPanel Orientation="Horizontal" Margin="8,5">
                                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Width="26" Height="26" Margin="0,0,8,0">
                                                        <Path Data="{StaticResource IconPhoto}" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Медиа" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- 2. Файл -->
                                            <Button Style="{StaticResource ModernTrayItemButton}"
                                                    Command="{Binding AttachFileCommand}"
                                                    ToolTip="Отправить документ или файл">
                                                <StackPanel Orientation="Horizontal" Margin="8,5">
                                                    <Border Background="#1E26A69A" CornerRadius="8" Width="26" Height="26" Margin="0,0,8,0">
                                                        <Path Data="{StaticResource IconFile}" Fill="#26A69A" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Файл" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- 3. GIF-анимация -->
                                            <Button Style="{StaticResource ModernTrayItemButton}"
                                                    Command="{Binding AttachGifCommand}"
                                                    ToolTip="Отправить GIF-анимацию">
                                                <StackPanel Orientation="Horizontal" Margin="8,5">
                                                    <Border Background="#1EB388FF" CornerRadius="8" Width="26" Height="26" Margin="0,0,8,0">
                                                        <TextBlock Text="GIF" Foreground="#B388FF" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="GIF" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Разделитель -->
                                            <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>

                                            <!-- 4. Фоторедактор -->
                                            <Button Style="{StaticResource ModernTrayItemButton}"
                                                    Command="{Binding OpenPhotoEditorCommand}"
                                                    ToolTip="Открыть фоторедактор и холст">
                                                <StackPanel Orientation="Horizontal" Margin="8,5">
                                                    <Border Background="#1EFFB74D" CornerRadius="8" Width="26" Height="26" Margin="0,0,8,0">
                                                        <Path Data="{StaticResource IconBrush}" Fill="#FFB74D" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Редактор" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>



                            <!-- Message Text Input with Integrated Emoji Button -->
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <TextBox x:Name="MsgInputTextBox" Style="{StaticResource ModernTextBox}"
                                             Text="{Binding InputMessageText, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewKeyDown="MsgInputTextBox_PreviewKeyDown"
                                             VerticalAlignment="Center" MinHeight="36" MaxHeight="100" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding InputPlaceholderText}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="13" Margin="10,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding HasInputText, Converter={StaticResource InverseBoolToVis}}"/>
                                </Grid>

                                <!-- Emoji Picker Trigger Button -->
                                <Button Grid.Column="1" Style="{StaticResource ModernButton}" Width="32" Height="32" Padding="0" Margin="4,0,2,0"
                                        ToolTip="Смайлики и эмодзи" x:Name="BtnEmojiPickerTrigger" Click="BtnEmojiPickerTrigger_Click"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="😊" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Popup x:Name="EmojiPickerPopup" PlacementTarget="{Binding ElementName=BtnEmojiPickerTrigger}"
                                       Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6">
                                    <controls:EmojiPickerControl x:Name="ChatEmojiPicker" />
                                </Popup>
                                <Popup x:Name="ExpandedReactionsPopup"
                                       Placement="MousePoint" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-10">
                                    <controls:ExpandedReactionsControl x:Name="ExpandedReactionsView" />
                                </Popup>
                            </Grid>

                            <!-- Actions: Formatting Button ("Ф") + Voice & Send Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                                <!-- Extended Formatting Button ("Ф") matching Android -->
                                <Button Style="{StaticResource ModernButton}" Width="34" Height="36" Padding="0" Margin="0,0,6,0"
                                        ToolTip="Расширенное форматирование (Ctrl+Shift+F)"
                                        Command="{Binding ToggleRichFormattingCommand}"
                                        Visibility="{Binding ShouldShowFormatButton, Converter={StaticResource BoolToVis}}">
                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Width="26" Height="26">
                                        <TextBlock Text="Ф" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Button>

                                <Button Style="{StaticResource ModernButton}" ToolTip="Голосовое сообщение"
                                        Command="{Binding ToggleVoiceRecordCommand}" Width="40" Height="36" Padding="0"
                                        Visibility="{Binding CanSendMessage, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid>
                                        <Path Data="{StaticResource IconMic}" Fill="{DynamicResource TextSecondaryBrush}" Width="15" Height="15" Stretch="Uniform"
                                              Visibility="{Binding IsRecordingVoice, Converter={StaticResource InverseBoolToVis}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Path Data="{StaticResource IconStop}" Fill="#FF5252" Width="14" Height="14" Stretch="Uniform"
                                              Visibility="{Binding IsRecordingVoice, Converter={StaticResource BoolToVis}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource AccentButton}" ToolTip="Отправить (Enter)"
                                        Command="{Binding SendMessageCommand}" Width="40" Height="36" Padding="0"
                                        Visibility="{Binding CanSendMessage, Converter={StaticResource BoolToVis}}">
                                    <Path Data="{StaticResource IconSend}" Fill="White" Width="16" Height="16" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>




                <!-- Reading Mode Banner (Displayed when in reading mode) -->
                <Border Grid.Row="2" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10"
                        Visibility="{Binding IsReadingMode, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button Content="🔗 Соединиться" Style="{StaticResource AccentButton}" DockPanel.Dock="Right" Padding="14,6" Margin="12,0,0,0"
                                Command="{Binding ToggleReadingModeCommand}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📖" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Режим чтения включен" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Связь отключена. Чтобы отправлять сообщения, нажмите «Соединиться»." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                </Grid>

                <!-- Empty Chat Placeholder (when no chat is selected) -->

                <Grid Visibility="{Binding HasSelectedChat, Converter={StaticResource InverseBoolToVis}}"

                      Background="{DynamicResource BackgroundBrush}">

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                        <Border Width="90" Height="90" CornerRadius="45" Background="{DynamicResource CardBrush}"

                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"

                                Margin="0,0,0,18" HorizontalAlignment="Center">

                            <Image Source="Assets/prime_logo_app.png" Width="54" Height="54" Opacity="0.8"

                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                        </Border>

                        <TextBlock Text="Выберите чат, с которым вы хотите общаться"

                                   Foreground="{DynamicResource TextSecondaryBrush}"

                                   FontSize="16" FontWeight="SemiBold"

                                   HorizontalAlignment="Center" Margin="0"/>

                    </StackPanel>

                </Grid>

            </Grid>



            <!-- Column 3: GridSplitter 2 -->

            <GridSplitter Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Stretch"

                          ResizeBehavior="PreviousAndNext" Width="5" Cursor="SizeWE"

                          Background="{DynamicResource BorderBrush}" Opacity="0.5"
                          Visibility="{Binding IsMediaDrawerOpen, Converter={StaticResource BoolToVis}}"/>



            <!-- Column 4: Profile & Info Drawer (PersonInformationActivity.kt layout) -->

            <Border Grid.Column="4" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                    SizeChanged="ProfileDrawer_SizeChanged"
                    Visibility="{Binding IsMediaDrawerOpen, Converter={StaticResource BoolToVis}}">

                <Border.RenderTransform>

                    <TranslateTransform X="0"/>

                </Border.RenderTransform>

                <Border.Style>

                    <Style TargetType="Border">

                        <Style.Triggers>

                            <EventTrigger RoutedEvent="Loaded">

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.22">

                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>

                                        </DoubleAnimation>

                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"

                                                         From="160" To="0" Duration="0:0:0.22">

                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>

                                        </DoubleAnimation>

                                    </Storyboard>

                                </BeginStoryboard>

                            </EventTrigger>

                        </Style.Triggers>

                    </Style>

                </Border.Style>



                <Grid>
                    <!-- Scrollable Profile Content -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>
                            <!-- 7.1. Header Card with Large Photo, Left Actions, and Story Avatar Flipping -->
                            <Border Height="270" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource CardBrush}" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <!-- Fallback Initials Display -->
                                    <Grid Background="{DynamicResource AccentBrush}" Visibility="{Binding SelectedChat.HasAvatar, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock Text="{Binding SelectedChat.Initials}" Foreground="White" FontSize="56" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Actual Avatar Photo (Floods the top/card) -->
                                    <Image Source="{Binding SelectedChat.CurrentAvatarDisplayPath, Converter={StaticResource NonLockingImgConverter}}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding SelectedChat.HasAvatar, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Left / Right Click Areas for fast cycling through avatar history -->
                                    <Grid Visibility="{Binding SelectedChat.HasMultipleAvatars, Converter={StaticResource BoolToVis}}" Margin="48,25,0,80">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="Transparent" Cursor="Hand" ToolTip="Предыдущий аватар">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding PrevContactAvatarCommand}"/>
                                            </Border.InputBindings>
                                        </Border>
                                        <Border Grid.Column="1" Background="Transparent" Cursor="Hand" ToolTip="Следующий аватар">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding NextContactAvatarCommand}"/>
                                            </Border.InputBindings>
                                        </Border>
                                    </Grid>

                                    <!-- Context Menu Area for the Avatar Card -->
                                    <Border Background="Transparent" IsHitTestVisible="True">
                                        <Border.ContextMenu>
                                            <ContextMenu Style="{StaticResource ModernContextMenu}">
                                                <MenuItem Header="📷 Сменить аватар" Style="{StaticResource ModernMenuItem}" Command="{Binding ChangeContactAvatarCommand}"/>
                                                <MenuItem Header="🗑️ Удалить этот аватар из истории" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteContactAvatarCommand}" Visibility="{Binding SelectedChat.HasAvatar, Converter={StaticResource BoolToVis}}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                    </Border>

                                    <!-- Top Segment Indicator Bars (Telegram / Instagram story style) -->
                                    <ItemsControl ItemsSource="{Binding SelectedChat.AvatarSegments}"
                                                  VerticalAlignment="Top" Margin="14,12,14,0"
                                                  Visibility="{Binding SelectedChat.HasMultipleAvatars, Converter={StaticResource BoolToVis}}"
                                                  IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="3" Margin="2,0" CornerRadius="1.5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#55FFFFFF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="#FFFFFFFF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Left Chevron Navigation Button (‹) -->
                                    <Button Style="{StaticResource ProfileChevronButton}"
                                            Command="{Binding PrevContactAvatarCommand}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Margin="52,0,0,0"
                                            ToolTip="Предыдущий аватар"
                                            Visibility="{Binding SelectedChat.HasMultipleAvatars, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="‹" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,-2,1,0"/>
                                    </Button>

                                    <!-- Right Chevron Navigation Button (›) -->
                                    <Button Style="{StaticResource ProfileChevronButton}"
                                            Command="{Binding NextContactAvatarCommand}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Margin="0,0,12,0"
                                            ToolTip="Следующий аватар"
                                            Visibility="{Binding SelectedChat.HasMultipleAvatars, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="›" FontSize="20" FontWeight="Bold" Foreground="White" Margin="1,-2,0,0"/>
                                    </Button>

                                    <!-- Left Vertical Action Buttons (Square along the left middle edge, expanding label on hover) -->
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <!-- 1. Закрыть -->
                                        <Button Style="{StaticResource ProfileGlassButton}"
                                                Command="{Binding ToggleMediaDrawerCommand}"
                                                ToolTip="Закрыть"
                                                Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="36" Height="36">
                                                    <TextBlock Text="✕" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Закрыть" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- 2. Фото -->
                                        <Button Style="{StaticResource ProfileGlassButton}"
                                                Command="{Binding OpenPhotoViewerCommand}"
                                                CommandParameter="{Binding SelectedChat.CurrentAvatarDisplayPath}"
                                                ToolTip="Просмотр фото"
                                                Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="36" Height="36">
                                                    <TextBlock Text="👁️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Фото" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- 3. Чтение -->
                                        <Button Style="{StaticResource ProfileGlassButton}"
                                                Command="{Binding ToggleReadingModeCommand}"
                                                ToolTip="{Binding ReadingModeToolTip}"
                                                Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="36" Height="36">
                                                    <TextBlock Text="{Binding ReadingModeButtonIcon}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <controls:AnimatedTextTransitionControl Text="{Binding ReadingModeButtonText}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- 4. Удалить -->
                                        <Button Style="{StaticResource ProfileGlassDangerButton}"
                                                Command="{Binding DeleteSelectedChatCommand}"
                                                ToolTip="Удалить чат">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="36" Height="36">
                                                    <TextBlock Text="🗑️" FontSize="13" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Удалить" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Bottom Gradient Overlay with Contact Info & Avatar Counter (кол-во фото) -->
                                    <Border VerticalAlignment="Bottom" Height="80" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#000B1017" Offset="0.0"/>
                                                <GradientStop Color="#CC0B1017" Offset="0.45"/>
                                                <GradientStop Color="#F50B1017" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <DockPanel VerticalAlignment="Bottom" Margin="14,0,14,10">
                                            <!-- Avatar Counter Pill on the right: (кол-во фото) -->
                                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                                    Background="#B3000000" CornerRadius="10" Padding="8,4"
                                                    Cursor="Hand" ToolTip="Следующий аватар"
                                                    Visibility="{Binding SelectedChat.HasAvatar, Converter={StaticResource BoolToVis}}">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" Command="{Binding NextContactAvatarCommand}"/>
                                                </Border.InputBindings>
                                                <controls:AnimatedTextTransitionControl Text="{Binding SelectedChat.AvatarCounterText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Contact Display Name & Status -->
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedChat.DisplayName}" Foreground="White" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                     <Ellipse Width="8" Height="8" Fill="{Binding SelectedChat.StatusColorHex, Converter={StaticResource HexToBrush}}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                     <controls:AnimatedTextTransitionControl Text="{Binding SelectedChat.StatusText}" Foreground="{Binding SelectedChat.StatusColorHex, Converter={StaticResource HexToBrush}}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 7.3. Sticky Tab Bar: Медиа | Файлы | Аудио -->

                            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="3" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>



                                    <!-- Tab 0: Медиа -->

                                    <Button Grid.Column="0" Style="{StaticResource ModernButton}" Padding="0,7" BorderThickness="0"

                                            Command="{Binding SelectProfileTabCommand}" CommandParameter="0">

                                        <TextBlock Text="📷 Медиа" FontSize="12" FontWeight="SemiBold"

                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                                    </Button>



                                    <!-- Tab 1: Файлы -->

                                    <Button Grid.Column="1" Style="{StaticResource ModernButton}" Padding="0,7" BorderThickness="0"

                                            Command="{Binding SelectProfileTabCommand}" CommandParameter="1">

                                        <TextBlock Text="📁 Файлы" FontSize="12" FontWeight="SemiBold"

                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                                    </Button>



                                    <!-- Tab 2: Аудио -->

                                    <Button Grid.Column="2" Style="{StaticResource ModernButton}" Padding="0,7" BorderThickness="0"

                                            Command="{Binding SelectProfileTabCommand}" CommandParameter="2">

                                        <TextBlock Text="🎵 Аудио" FontSize="12" FontWeight="SemiBold"

                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                                    </Button>

                                </Grid>

                            </Border>



                            <!-- Tab 0 Content: Медиа (Photos & Videos Grid) -->
                            <StackPanel Visibility="{Binding SelectedProfileTab, Converter={StaticResource EqualityToVis}, ConverterParameter=0}">
                                <TextBlock Text="ОБЩИЕ МЕДИАФАЙЛЫ (ФОТО И ВИДЕО)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="2,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding SharedMediaList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding DataContext.ProfileGridColumns, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="95" Margin="2" CornerRadius="8" ClipToBounds="True" Background="#141C28" Cursor="Hand"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Border.ContextMenu>
                                                    <ContextMenu Style="{StaticResource ModernContextMenu}">
                                                        <MenuItem Header="🖼️ Просмотреть" Style="{StaticResource ModernMenuItem}"
                                                                  Command="{Binding PlacementTarget.Tag.OpenPhotoViewerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext.FilePath, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="🎨 Редактировать фото" Style="{StaticResource ModernMenuItem}"
                                                                  Command="{Binding PlacementTarget.Tag.OpenPhotoEditorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext.FilePath, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Visibility="{Binding PlacementTarget.DataContext.IsVideo, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"/>
                                                        <MenuItem Header="📁 Показать в проводнике" Style="{StaticResource ModernMenuItem}"
                                                                  Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext.FilePath, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding DataContext.OpenPhotoViewerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding FilePath}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <!-- Photo / Thumbnail -->
                                                    <Image Source="{Binding FilePath, Converter={StaticResource NonLockingImgConverter}}"
                                                           Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>

                                                    <!-- Video Indicator Overlay if Video -->
                                                    <Grid Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                                        <Border VerticalAlignment="Bottom" Height="30">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                    <GradientStop Color="#00000000" Offset="0.0"/>
                                                                    <GradientStop Color="#D9000000" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="6,0,0,5">
                                                            <Border Width="16" Height="16" CornerRadius="8" Background="#CC000000" Margin="0,0,4,0">
                                                                <Path Data="{StaticResource IconPlay}" Fill="White" Width="7" Height="7" Stretch="Uniform" Margin="1,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty placeholder if no media -->
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="16" Margin="0,4,0,0"
                                        Visibility="{Binding HasSharedMedia, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="Нет общих фото и видео" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>



                            <!-- Tab 1 Content: Файлы (Documents & Attachments in Responsive Grid) -->
                            <StackPanel Visibility="{Binding SelectedProfileTab, Converter={StaticResource EqualityToVis}, ConverterParameter=1}">
                                <TextBlock Text="ПЕРЕДАННЫЕ ДОКУМЕНТЫ И ФАЙЛЫ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="2,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding SharedFileList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding DataContext.ProfileGridColumns, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="110" Margin="2" CornerRadius="10" Background="{DynamicResource CardBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="7" Cursor="Hand"
                                                    ToolTip="{Binding FileName}"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Border.ContextMenu>
                                                    <ContextMenu Style="{StaticResource ModernContextMenu}">
                                                        <MenuItem Header="Открыть файл" Style="{StaticResource ModernMenuItem}"
                                                                  Command="{Binding PlacementTarget.Tag.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext.FilePath, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="📁 Показать в Загрузках / Проводнике" Style="{StaticResource ModernMenuItem}"
                                                                  Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext.FilePath, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding FilePath}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Top: Extension Badge and Downloads / Explorer Button -->
                                                    <DockPanel Grid.Row="0">
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource ModernButton}" Width="24" Height="24" Padding="0"
                                                                Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding FilePath}"
                                                                ToolTip="Перейти к файлу в Загрузках на ПК">
                                                            <TextBlock Text="📁" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>

                                                        <Border CornerRadius="4" Padding="5,2" HorizontalAlignment="Left"
                                                                Background="{Binding BadgeBrushHex, Converter={StaticResource HexToBrush}}">
                                                            <TextBlock Text="{Binding ExtensionBadge}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                    </DockPanel>

                                                    <!-- Middle: File Name -->
                                                    <TextBlock Grid.Row="1" Text="{Binding FileName}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap" MaxHeight="34" Margin="0,4,0,2" VerticalAlignment="Center"/>

                                                    <!-- Bottom: File Size -->
                                                    <TextBlock Grid.Row="2" Text="{Binding FormattedSize}" Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="10" VerticalAlignment="Bottom"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="16" Margin="0,4,0,0"
                                        Visibility="{Binding HasSharedFiles, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="Нет переданных файлов" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>



                            <!-- Tab 2 Content: Аудио (Voice Notes & Music in Responsive Grid 3 to 5 wide) -->
                            <StackPanel Visibility="{Binding SelectedProfileTab, Converter={StaticResource EqualityToVis}, ConverterParameter=2}">
                                <TextBlock Text="ГОЛОСОВЫЕ ЗАМЕТКИ И МУЗЫКА" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="2,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding SharedAudio}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding DataContext.ProfileGridColumns, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="110" Margin="2" CornerRadius="10" Background="{DynamicResource CardBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="6"
                                                    ToolTip="{Binding FileName}"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Border.ContextMenu>
                                                    <ContextMenu Style="{StaticResource ModernContextMenu}">
                                                        <MenuItem Header="🎵 Воспроизвести / Пауза" Style="{StaticResource ModernMenuItem}"
                                                                  Command="{Binding PlacementTarget.Tag.PlayVoiceMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="📁 Показать в проводнике" Style="{StaticResource ModernMenuItem}"
                                                                  Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext.FilePath, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Top: Circular Play/Pause Button -->
                                                    <Button Grid.Row="0" Style="{StaticResource ModernButton}" Width="36" Height="36" Padding="0"
                                                            HorizontalAlignment="Center" Margin="0,2,0,3"
                                                            Command="{Binding DataContext.PlayVoiceMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Grid>
                                                            <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentBrush}" Opacity="0.18"/>
                                                            <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource AccentBrush}" Width="13" Height="13" Stretch="Uniform"
                                                                  Margin="2,0,0,0"
                                                                  Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Path Data="{StaticResource IconPause}" Fill="{DynamicResource AccentBrush}" Width="13" Height="13" Stretch="Uniform"
                                                                  Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Button>

                                                    <!-- Middle: Title / Voice -->
                                                    <TextBlock Grid.Row="1" Text="{Binding FileName, TargetNullValue='Голосовое'}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" MaxWidth="90"/>

                                                    <!-- Bottom: Duration & Music Icon -->
                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                        <TextBlock Text="🎵" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Text="{Binding DisplayPlayTime}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="16" Margin="0,4,0,0"
                                        Visibility="{Binding HasSharedAudio, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="Нет аудиозаписей" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>




                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Grid>



        <!-- ============================================== -->

        <!-- DEVICE DISCOVERY MODAL OVERLAY (PARAM 3)       -->

        <!-- ============================================== -->

        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#A005070D"
              Visibility="{Binding IsDiscoveryOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="90">

            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Width="480" MaxHeight="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.6" Color="#000000"/>
                </Border.Effect>

                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                        <TranslateTransform Y="0"/>
                    </TransformGroup>
                </Border.RenderTransform>

                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDiscoveryOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.32">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                             From="0.82" To="1.0" Duration="0:0:0.32">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                             From="0.82" To="1.0" Duration="0:0:0.32">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                             From="40" To="0" Duration="0:0:0.32">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Margin="22">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/> <!-- Header -->

                        <RowDefinition Height="*"/>    <!-- Devices List -->

                        <RowDefinition Height="Auto"/> <!-- Bottom Actions -->

                    </Grid.RowDefinitions>



                    <!-- Header -->

                    <DockPanel Grid.Row="0" Margin="0,0,0,16">

                        <Button Content="✕" Style="{StaticResource ModernButton}" Command="{Binding CloseDeviceDiscoveryCommand}"

                                DockPanel.Dock="Right" Width="30" Height="30" Padding="0"/>

                        <StackPanel>

                            <TextBlock Text="Поиск устройств Prime" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold"/>

                            <TextBlock Text="Периферия и наушники отфильтрованы" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>

                        </StackPanel>

                    </DockPanel>



                    <!-- Devices List -->

                    <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" CornerRadius="10" Padding="8" Margin="0,0,0,16">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <StackPanel>

                                <ProgressBar Height="3" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}"

                                             Background="Transparent" BorderThickness="0" Margin="0,0,0,8"

                                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>



                                <TextBlock Text="Доступные устройства не найдены"

                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12"

                                           HorizontalAlignment="Center" Margin="0,30,0,0"

                                           Visibility="{Binding DiscoveredDevices.Count, Converter={StaticResource InverseBoolToVis}}"/>



                                <ItemsControl ItemsSource="{Binding DiscoveredDevices}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"

                                                    BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,3">

                                                <DockPanel>

                                                    <Button Content="Начать чат" Style="{StaticResource AccentButton}"

                                                            DockPanel.Dock="Right" FontSize="11" Padding="10,4"

                                                            Command="{Binding DataContext.StartChatWithDiscoveredCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                                            CommandParameter="{Binding}"/>

                                                    <StackPanel VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>

                                                        <TextBlock Text="Prime совместимое устройство" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>

                                                    </StackPanel>

                                                </DockPanel>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>

                        </ScrollViewer>

                    </Border>



                    <!-- Bottom Actions -->

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">

                        <Button Content="Обновить" Style="{StaticResource ModernButton}" Command="{Binding ScanDevicesCommand}" Margin="0,0,8,0"/>

                        <Button Content="Закрыть" Style="{StaticResource ModernButton}" Command="{Binding CloseDeviceDiscoveryCommand}"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

</Grid>

</Window>
