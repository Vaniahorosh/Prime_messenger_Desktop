<Window x:Class="PrimeDesktop.Views.PhotoViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PrimeDesktop.Controls"
        Title="Просмотр медиа — Прайм"
        Icon="../Assets/prime.ico"
        Height="760" Width="1060"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PrimeDesktop;component/Resources/PrimeIcons.xaml"/>
                <ResourceDictionary Source="/PrimeDesktop;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Translucent Dark Backdrop -->
    <Border x:Name="PART_Backdrop"
            Background="#D0060910"
            MouseLeftButtonDown="Backdrop_MouseLeftButtonDown">
        <Grid>
            <!-- Top Floating Header Bar (File Name, Details, Window Control Buttons) -->
            <Grid VerticalAlignment="Top" Height="48" Margin="20,14,20,0" Panel.ZIndex="10"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: File Name & Details -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFileName" Text="Медиафайл" Foreground="White" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                    <TextBlock x:Name="TxtMediaDetails" Text="" Foreground="#AAFFFFFF" FontSize="11.5" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Window Caption Buttons (Minimize, Maximize, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CaptionButtonStyle}" ToolTip="Свернуть" Click="BtnMinimize_Click" Width="34" Height="34">
                        <Path Width="10" Height="1" Stretch="None" Stroke="White" StrokeThickness="1" SnapsToDevicePixels="True" Data="M 0,0.5 H 10"/>
                    </Button>
                    <Button x:Name="BtnMaximize" Style="{StaticResource CaptionButtonStyle}" ToolTip="Развернуть" Click="BtnMaximize_Click" Width="34" Height="34">
                        <Grid>
                            <Path x:Name="IconMaximize" Width="10" Height="10" Stretch="None" Stroke="White" StrokeThickness="1" SnapsToDevicePixels="True" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z"/>
                            <Path x:Name="IconRestore" Width="10" Height="10" Stretch="None" Stroke="White" StrokeThickness="1" SnapsToDevicePixels="True" Data="M 2.5,0.5 H 9.5 V 7.5 H 7.5 M 0.5,2.5 H 7.5 V 9.5 H 0.5 Z" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButtonStyle}" ToolTip="Закрыть (Esc)" Click="BtnClose_Click" Width="34" Height="34">
                        <Path Width="10" Height="10" Stretch="None" Stroke="White" StrokeThickness="1" SnapsToDevicePixels="True" Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Center Viewport Area -->
            <Grid Margin="0,50,0,0">
                <!-- Volume HUD Indicator (Top-Center) -->
                <Border x:Name="VolumeHud" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,20,0,0" Background="#E0000000" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1.5" CornerRadius="14" Padding="16,7" Visibility="Collapsed" Panel.ZIndex="30">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="IconHudVolume" Data="{StaticResource IconVolumeUp}" Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtHudVolume" Text="100%" Foreground="White" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- 1. PHOTO VIEWPORT -->
                <ScrollViewer x:Name="PhotoScrollViewer"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              Focusable="False"
                              PreviewMouseLeftButtonDown="ScrollViewer_MouseLeftButtonDown"
                              PreviewMouseMove="ScrollViewer_MouseMove"
                              PreviewMouseLeftButtonUp="ScrollViewer_MouseLeftButtonUp"
                              Cursor="Hand">
                    <Grid x:Name="ImageGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="TargetImage"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5"/>
                                    <TranslateTransform x:Name="ImageTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </ScrollViewer>

                <!-- 2. VIDEO VIEWPORT -->
                <Grid x:Name="VideoContainer" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <MediaElement x:Name="PART_Video"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  Stretch="Uniform"
                                  MediaOpened="Video_MediaOpened"
                                  MediaEnded="Video_MediaEnded"
                                  MediaFailed="Video_MediaFailed"
                                  MouseLeftButtonDown="Video_MouseLeftButtonDown"/>

                    <!-- Big Play/Pause Center Indicator -->
                    <Border x:Name="VideoPauseOverlay" Width="64" Height="64" CornerRadius="32"
                            Background="#88000000" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="Video_MouseLeftButtonDown" Visibility="Collapsed">
                        <Path Data="{StaticResource IconPlay}" Fill="White" Width="22" Height="22" Margin="3,0,0,0"
                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Floating Video Control Bar (Bottom-Center, only for videos) -->
                <Border x:Name="VideoControlBar" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="0,0,0,24" Background="#CC0F1724" BorderBrush="#30FFFFFF" BorderThickness="1"
                        CornerRadius="16" Padding="14,6" Visibility="Collapsed" Panel.ZIndex="10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Play/Pause -->
                        <Button Style="{StaticResource ModernButton}" Width="32" Height="32" Padding="0" Click="BtnVideoPlayPause_Click">
                            <Grid>
                                <Path x:Name="IconVidPlay" Data="{StaticResource IconPlay}" Fill="White" Width="14" Height="14" Stretch="Uniform"/>
                                <Path x:Name="IconVidPause" Data="{StaticResource IconPause}" Fill="White" Width="14" Height="14" Stretch="Uniform" Visibility="Collapsed"/>
                            </Grid>
                        </Button>

                        <!-- Current Time -->
                        <TextBlock x:Name="TxtVideoCurrent" Text="0:00" Foreground="White" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,8,0"/>

                        <!-- Seek Slider -->
                        <Slider x:Name="SliderVideoProgress" Width="260" VerticalAlignment="Center"
                                Minimum="0" Maximum="100" Value="0"
                                PreviewMouseDown="Slider_PreviewMouseDown"
                                PreviewMouseUp="Slider_PreviewMouseUp"
                                ValueChanged="Slider_ValueChanged"/>

                        <!-- Total Time -->
                        <TextBlock x:Name="TxtVideoTotal" Text="0:00" Foreground="#AAFFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,10,0"/>

                        <!-- Mute / Unmute -->
                        <Button Style="{StaticResource ModernButton}" Width="28" Height="28" Padding="0" Click="BtnVideoMute_Click" ToolTip="Звук">
                            <Grid>
                                <Path x:Name="IconVidSoundOn" Data="{StaticResource IconVolumeUp}" Fill="White" Width="13" Height="13" Stretch="Uniform"/>
                                <Path x:Name="IconVidSoundOff" Data="{StaticResource IconVolumeMute}" Fill="#FF7777" Width="13" Height="13" Stretch="Uniform" Visibility="Collapsed"/>
                            </Grid>
                        </Button>

                        <!-- Speed Button -->
                        <Border CornerRadius="12" Background="#30FFFFFF" Margin="8,0,0,0">
                            <Button Style="{StaticResource ModernButton}" Padding="6,2" Height="24"
                                    Background="Transparent" BorderThickness="0"
                                    Click="BtnVideoSpeed_Click" ToolTip="Скорость">
                                <TextBlock x:Name="TxtVideoSpeed" Text="1x" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Button>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Left Navigation Arrow ❮ -->
                <Border x:Name="BtnPrevMedia"
                        Width="44" Height="44" CornerRadius="22" Background="#60000000" BorderBrush="#25FFFFFF" BorderThickness="1"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"
                        Panel.ZIndex="10">
                    <Button Style="{StaticResource ModernButton}" Width="42" Height="42" Background="Transparent" BorderThickness="0"
                            Click="BtnPrev_Click" ToolTip="Предыдущее (Влево / Колесо вверх)">
                        <TextBlock Text="❮" Foreground="White" FontSize="18" FontWeight="Bold" Margin="-2,0,0,0"/>
                    </Button>
                </Border>

                <!-- Right Navigation Arrow ❯ -->
                <Border x:Name="BtnNextMedia"
                        Width="44" Height="44" CornerRadius="22" Background="#60000000" BorderBrush="#25FFFFFF" BorderThickness="1"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
                        Panel.ZIndex="10">
                    <Button Style="{StaticResource ModernButton}" Width="42" Height="42" Background="Transparent" BorderThickness="0"
                            Click="BtnNext_Click" ToolTip="Следующее (Вправо / Колесо вниз)">
                        <TextBlock Text="❯" Foreground="White" FontSize="18" FontWeight="Bold" Margin="2,0,0,0"/>
                    </Button>
                </Border>

                <!-- Bottom-Left Auto-Expanding Action Tray Island (Панель функций) -->
                <Border x:Name="BottomActionTray"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="24,0,0,24"
                        Panel.ZIndex="25"
                        Background="#E0111927"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="8"
                        RenderTransformOrigin="0,1"
                        MouseEnter="BottomActionTray_MouseEnter"
                        MouseLeave="BottomActionTray_MouseLeave">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#000000"/>
                    </Border.Effect>

                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="TrayScale" ScaleX="1.0" ScaleY="1.0"/>
                            <TranslateTransform x:Name="TrayTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Tray Icon / Indicator Badge -->
                        <Border x:Name="TrayBadge"
                                Width="36" Height="36" CornerRadius="18"
                                Background="{DynamicResource AccentSoftBrush}"
                                Cursor="Hand" Margin="0,0,6,0">
                            <Path Data="{StaticResource IconSettings}"
                                  Fill="{DynamicResource AccentBrush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Expandable Container of Action Buttons -->
                        <StackPanel x:Name="TrayExpandedContent"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Opacity="0">
                            <!-- Photo Zoom Controls (hidden for video) -->
                            <StackPanel x:Name="PhotoZoomPanel" Orientation="Horizontal" Margin="0,0,8,0">
                                <Button Content="🔍 -" Style="{StaticResource ModernButton}" Click="BtnZoomOut_Click" ToolTip="Уменьшить" Padding="8,4" Margin="0,0,4,0" Background="#35000000"/>
                                <Button x:Name="BtnZoomReset" Content="100%" Style="{StaticResource ModernButton}" Click="BtnZoom100_Click" ToolTip="Масштаб 1:1" Padding="8,4" Margin="0,0,4,0" Background="#35000000"/>
                                <Button Content="🔍 +" Style="{StaticResource ModernButton}" Click="BtnZoomIn_Click" ToolTip="Увеличить" Padding="8,4" Margin="0,0,4,0" Background="#35000000"/>
                                <Button Content="↔ По окну" Style="{StaticResource ModernButton}" Click="BtnZoomFit_Click" ToolTip="Вписать" Padding="8,4" Margin="0,0,4,0" Background="#35000000"/>
                            </StackPanel>

                            <Button Content="📋 Копировать" Style="{StaticResource ModernButton}" Click="BtnCopy_Click" ToolTip="Копировать (Ctrl+C)" Padding="10,4" Margin="0,0,6,0" Background="#35000000"/>
                            <Button Content="💾 Сохранить" Style="{StaticResource AccentButton}" Click="BtnSave_Click" ToolTip="Сохранить файл (Ctrl+S)" Padding="12,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Bottom-Right Info Badge (От кого + Номер фото/видео) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,24,24" Background="#88000000" BorderBrush="#25FFFFFF" BorderThickness="1"
                        CornerRadius="14" Padding="14,8" Panel.ZIndex="10">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtInfoSender" Text="Отправитель" Foreground="White" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Right"/>
                        <controls:AnimatedTextTransitionControl x:Name="TxtInfoCounter" Text="Фото 1 из 1" Foreground="#AAFFFFFF" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
