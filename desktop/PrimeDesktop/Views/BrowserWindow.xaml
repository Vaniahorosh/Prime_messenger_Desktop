                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel>
                    <TextBlock Text="ОСНОВНОЙ БРАУЗЕР" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Где открывать веб-ссылки из мессенджера:"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    <RadioButton x:Name="RbStartBrowserInternal"
                                 GroupName="StartBrowserChoice"
                                 Content="Встроенный браузер «Prime»"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="12" Margin="0,0,0,6"
                                 Click="RbStartBrowserInternal_Click"/>

                    <RadioButton x:Name="RbStartBrowserSystem"
                                 GroupName="StartBrowserChoice"
                                 Content="Системный браузер Windows"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="12" Margin="0,0,0,12"
                                 Click="RbStartBrowserSystem_Click"/>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,10"/>

                    <TextBlock Text="ПОИСКОВАЯ СИСТЕМА" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>

                    <StackPanel x:Name="StartSearchEnginesContainer">
                        <Button Style="{StaticResource ModernButton}" HorizontalContentAlignment="Left"
                                Padding="10,5" Margin="0,0,0,4" Tag="Google" Click="StartSearchEngineItem_Click">
                            <DockPanel>
                                <TextBlock Text="Google" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCheckGoogle" Text="✓" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"
                                           HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Button>

                        <Button Style="{StaticResource ModernButton}" HorizontalContentAlignment="Left"
                                Padding="10,5" Margin="0,0,0,4" Tag="Яндекс" Click="StartSearchEngineItem_Click">
                            <DockPanel>
                                <TextBlock Text="Яндекс" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCheckYandex" Text="✓" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"
                                           HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </DockPanel>
                        </Button>

                        <Button Style="{StaticResource ModernButton}" HorizontalContentAlignment="Left"
                                Padding="10,5" Margin="0,0,0,4" Tag="DuckDuckGo" Click="StartSearchEngineItem_Click">
                            <DockPanel>
                                <TextBlock Text="DuckDuckGo" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCheckDuckDuckGo" Text="✓" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"
                                           HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </DockPanel>
                        </Button>

                        <Button Style="{StaticResource ModernButton}" HorizontalContentAlignment="Left"
                                Padding="10,5" Margin="0,0,0,4" Tag="Bing" Click="StartSearchEngineItem_Click">
                            <DockPanel>
                                <TextBlock Text="Bing" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCheckBing" Text="✓" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"
                                           HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="TxtStartSavedNotification" Text="✓ Настройка сохранена!"
                               FontSize="11" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- POPUP: BROWSER SETTINGS FLYOUT -->
        <Popup x:Name="BrowserSettingsPopup"
