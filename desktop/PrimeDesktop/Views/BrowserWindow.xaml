<Window x:Class="PrimeDesktop.Views.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:conv="clr-namespace:PrimeDesktop.Converters"
        mc:Ignorable="d"
        Title="Браузер Prime" Height="740" Width="1100"
        MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <!-- Tab Orientation & Pin Icons -->
        <Geometry x:Key="IconTabsVertical">M3,3H21V21H3V3M5,5V19H9V5H5M11,5V19H19V5H11Z</Geometry>
        <Geometry x:Key="IconTabsHorizontal">M3,3H21V21H3V3M5,5V9H19V5H5M5,11V19H19V11H5Z</Geometry>
        <Geometry x:Key="IconPin">M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z</Geometry>
        <Geometry x:Key="IconHome">M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z</Geometry>

        <!-- Tab Item Header Style -->
        <Style x:Key="BrowserTabButtonStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1,1,1,0"
                                CornerRadius="8,8,0,0"
                                Padding="10,6,8,6"
                                Margin="0,4,4,0"
                                MaxWidth="220"
                                MinWidth="110"
                                RenderTransformOrigin="0.5,1"
                                Tag="{Binding}">
                            <Border.ContextMenu>
                                <ContextMenu Style="{StaticResource ModernContextMenu}" Opened="TabContextMenu_Opened" Closed="TabContextMenu_Closed">
                                    <MenuItem Header="➕ Новая вкладка" Click="MenuTabNew_Click"/>
                                    <MenuItem Header="🔄 Перезагрузить" Click="MenuTabReload_Click"/>
                                    <MenuItem Header="📋 Дублировать вкладку" Click="MenuTabDuplicate_Click"/>
                                    <MenuItem Header="📌 Закрепить вкладку" Tag="pin" Click="MenuTabPin_Click"/>
                                    <Separator/>
                                    <MenuItem Header="✕ Закрыть вкладку" Style="{StaticResource DangerMenuItem}" Click="MenuTabClose_Click"/>
                                    <MenuItem Header="✕ Закрыть другие вкладки" Style="{StaticResource DangerMenuItem}" Click="MenuTabCloseOthers_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TabTranslate" Y="0"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Favicon / Globe icon -->
                                <Grid Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Image Source="{Binding Favicon}" Stretch="Uniform"
                                           Visibility="{Binding Favicon, Converter={StaticResource BoolToVis}}"/>
                                    <Path Data="{StaticResource IconGlobe}" Fill="{DynamicResource TextSecondaryBrush}"
                                          Stretch="Uniform" Width="13" Height="13"
                                          Visibility="{Binding Favicon, Converter={StaticResource InverseBoolToVis}}"/>
                                </Grid>

                                <!-- Tab Title -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           x:Name="TabTitleText"/>

                                <!-- Close Tab Button -->
                                <Button Grid.Column="2"
                                        x:Name="BtnCloseTab"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Width="18" Height="18"
                                        Padding="0" Margin="6,0,0,0"
                                        ToolTip="Закрыть вкладку (Ctrl+W)"
                                        Click="BtnCloseTab_Click"
                                        Tag="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Brd" Background="Transparent" CornerRadius="9">
                                                <Path Data="{StaticResource IconClose}"
                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                      Width="8" Height="8" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Brd" Property="Background" Value="#33FF5252"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="TabBorder" Property="MinWidth" Value="38"/>
                                <Setter TargetName="TabBorder" Property="MaxWidth" Value="38"/>
                                <Setter TargetName="TabBorder" Property="Padding" Value="8,6,8,6"/>
                                <Setter TargetName="TabTitleText" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="BtnCloseTab" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="TabBorder" Property="ToolTip" Value="{Binding Title}"/>
                            </DataTrigger>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TabBorder"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="18" To="0"
                                                         Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TabBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.2" To="1.0"
                                                         Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#25243344"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#D9162130"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3D5370"/>
                                <Setter TargetName="TabTitleText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="TabTitleText" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round Pill Address Bar Button -->
        <Style x:Key="AddressNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Tile Button for Recent Sites on Start Screen -->
        <Style x:Key="StartScreenSiteTileButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBrd"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Width="110"
                                Height="84"
                                Padding="8,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="32" Height="32" CornerRadius="16"
                                        Background="{DynamicResource HeaderBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding InitialLetter}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding DisplayTitle}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBrd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="TileBrd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBrd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Miniature Vertical Tab Item Style (Width 36x36 Icon Only) -->
        <Style x:Key="MiniVerticalTabButtonStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{Binding Title}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Width="36" Height="36"
                                Margin="5,2"
                                Tag="{Binding}">
                            <Border.ContextMenu>
                                <ContextMenu Style="{StaticResource ModernContextMenu}" Opened="TabContextMenu_Opened" Closed="TabContextMenu_Closed">
                                    <MenuItem Header="➕ Новая вкладка" Click="MenuTabNew_Click"/>
                                    <MenuItem Header="🔄 Перезагрузить" Click="MenuTabReload_Click"/>
                                    <MenuItem Header="📋 Дублировать вкладку" Click="MenuTabDuplicate_Click"/>
                                    <MenuItem Header="📌 Закрепить вкладку" Tag="pin" Click="MenuTabPin_Click"/>
                                    <Separator/>
                                    <MenuItem Header="✕ Закрыть вкладку" Style="{StaticResource DangerMenuItem}" Click="MenuTabClose_Click"/>
                                    <MenuItem Header="✕ Закрыть другие вкладки" Style="{StaticResource DangerMenuItem}" Click="MenuTabCloseOthers_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="{Binding Favicon}" Stretch="Uniform"
                                       Visibility="{Binding Favicon, Converter={StaticResource BoolToVis}}"/>
                                <Path Data="{StaticResource IconGlobe}" Fill="{DynamicResource TextSecondaryBrush}"
                                      Stretch="Uniform" Width="14" Height="14"
                                      Visibility="{Binding Favicon, Converter={StaticResource InverseBoolToVis}}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Expandable Vertical Tab Item Style (Icon + Title + Close Button / Pin Badge) -->
        <Style x:Key="BrowserVerticalTabButtonStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{Binding Title}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="36"
                                Margin="5,2"
                                Tag="{Binding}">
                            <Border.ContextMenu>
                                <ContextMenu Style="{StaticResource ModernContextMenu}" Opened="TabContextMenu_Opened" Closed="TabContextMenu_Closed">
                                    <MenuItem Header="➕ Новая вкладка" Click="MenuTabNew_Click"/>
                                    <MenuItem Header="🔄 Перезагрузить" Click="MenuTabReload_Click"/>
                                    <MenuItem Header="📋 Дублировать вкладку" Click="MenuTabDuplicate_Click"/>
                                    <MenuItem Header="📌 Закрепить вкладку" Tag="pin" Click="MenuTabPin_Click"/>
                                    <Separator/>
                                    <MenuItem Header="✕ Закрыть вкладку" Style="{StaticResource DangerMenuItem}" Click="MenuTabClose_Click"/>
                                    <MenuItem Header="✕ Закрыть другие вкладки" Style="{StaticResource DangerMenuItem}" Click="MenuTabCloseOthers_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Favicon / Globe icon -->
                                <Grid Grid.Column="0" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding Favicon}" Stretch="Uniform"
                                           Visibility="{Binding Favicon, Converter={StaticResource BoolToVis}}"/>
                                    <Path Data="{StaticResource IconGlobe}" Fill="{DynamicResource TextSecondaryBrush}"
                                          Stretch="Uniform" Width="14" Height="14"
                                          Visibility="{Binding Favicon, Converter={StaticResource InverseBoolToVis}}"/>
                                </Grid>

                                <!-- Tab Title -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           x:Name="TabTitleText"
                                           Margin="2,0,4,0"/>

                                <!-- Pin Badge (shown when pinned) -->
                                <Path x:Name="IconPinBadge" Grid.Column="2"
                                      Data="{StaticResource IconPin}"
                                      Fill="{DynamicResource AccentBrush}"
                                      Width="11" Height="11" Stretch="Uniform"
                                      Margin="0,0,8,0" VerticalAlignment="Center"
                                      Visibility="Collapsed"
                                      ToolTip="Закрепленная вкладка"/>

                                <!-- Close Tab Button -->
                                <Button Grid.Column="2"
                                        x:Name="BtnCloseTab"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Width="22" Height="22"
                                        Padding="0" Margin="0,0,6,0"
                                        ToolTip="Закрыть вкладку (Ctrl+W)"
                                        Click="BtnCloseTab_Click"
                                        Tag="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Brd" Background="Transparent" CornerRadius="11">
                                                <Path Data="{StaticResource IconClose}"
                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                      Width="8" Height="8" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Brd" Property="Background" Value="#33FF5252"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="BtnCloseTab" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="IconPinBadge" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="TabTitleText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="TabTitleText" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Chrome Tab Strip + System Caption Buttons -->
            <RowDefinition x:Name="RowTabStrip" Height="42"/>
            <!-- Row 1: Address Bar & Customizable Toolbar -->
            <RowDefinition x:Name="RowAddressBar" Height="Auto"/>
            <!-- Row 2: Progress indicator line -->
            <RowDefinition x:Name="RowProgressBar" Height="2"/>
            <!-- Row 3: Active WebView2 tabs container -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- FROSTED GLASS REFRACTIVE BACKDROP (Spanning Tab Strip and Toolbar Rows 0 and 1) -->
        <Border Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="0" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush x:Name="GlassBackdropBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="GlassBackdropStop0" Color="#E60D1420" Offset="0"/>
                    <GradientStop x:Name="GlassBackdropStop1" Color="#B8142337" Offset="0.35"/>
                    <GradientStop x:Name="GlassBackdropStop2" Color="#991B324F" Offset="0.70"/>
                    <GradientStop x:Name="GlassBackdropStop3" Color="#D90E1624" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="0" IsHitTestVisible="False" Opacity="0.30" x:Name="GlassSpecularHighlight">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.30"/>
                    <GradientStop Color="#00000000" Offset="0.80"/>
                    <GradientStop Color="#1AFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ROW 0: TAB STRIP + WINDOW CONTROLS + TABS TOOLBAR PANELS (Frosted Glass) -->
        <Grid Grid.Row="0" Panel.ZIndex="1" Background="#B80E1520">
            <Grid.ColumnDefinitions>
                <!-- Tabs Area & Unified Elements -->
                <ColumnDefinition Width="*"/>
                <!-- Tab Counter & Caption Buttons -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" BorderBrush="#25374C" BorderThickness="0,0,0,1" Panel.ZIndex="0" IsHitTestVisible="False"/>

            <!-- Chrome Tab Strip with Scroll, Add Button and optional unified toolbar elements -->
            <DockPanel Grid.Column="0" Margin="6,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Vertical tabs title placeholder when vertical tabs are active -->
                <TextBlock x:Name="TxtVerticalTitle" Text="Prime Browser" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,12,0"
                           Visibility="Collapsed" DockPanel.Dock="Left" IsHitTestVisible="False"/>

                <!-- Tabs Toolbar Left Panel (Drop Target) -->
                <StackPanel x:Name="TabsToolbarLeftPanel" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                            Background="Transparent" MinWidth="10" WindowChrome.IsHitTestVisibleInChrome="True"
                            Margin="0,0,4,0" AllowDrop="True" DragOver="ToolbarPanel_DragOver" Drop="ToolbarPanel_Drop" DragLeave="ToolbarPanel_DragLeave"/>

                <!-- Tabs Toolbar Right Panel (Drop Target) -->
                <StackPanel x:Name="TabsToolbarRightPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Background="Transparent" MinWidth="10" WindowChrome.IsHitTestVisibleInChrome="True"
                            Margin="4,0,4,0" AllowDrop="True" DragOver="ToolbarPanel_DragOver" Drop="ToolbarPanel_Drop" DragLeave="ToolbarPanel_DragLeave"/>

                <!-- Tabs Address Bar Host (Host for address bar when in tab row) -->
                <Border x:Name="TabsAddressBarHost" DockPanel.Dock="Right" VerticalAlignment="Center"
                        MaxWidth="420" MinWidth="180" Margin="4,3,4,3" Visibility="Collapsed"/>

                <!-- Scrollable Tabs List with (+) button immediately adjacent -->
                <ScrollViewer x:Name="TabsScrollViewer"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly"
                              PreviewMouseWheel="TabsScrollViewer_PreviewMouseWheel"
                              RenderTransformOrigin="0.5,0.5">

                    <StackPanel Orientation="Horizontal">
                        <ItemsControl x:Name="TabsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="HorizontalTabsGroup"
                                                 IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                 Style="{StaticResource BrowserTabButtonStyle}"
                                                 Click="TabButton_Click"
                                                 PreviewMouseDown="TabButton_PreviewMouseDown"
                                                 MouseEnter="TabButton_MouseEnter"
                                                 MouseLeave="TabButton_MouseLeave"
                                                 Tag="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add New Tab Button (+) right next to tabs -->
                        <Button x:Name="BtnNewTab"
                                Style="{StaticResource AddressNavButton}"
                                Width="28" Height="28" Margin="4,0,8,0"
                                VerticalAlignment="Center"
                                ToolTip="Новая вкладка (Ctrl+T)"
                                Click="BtnNewTab_Click">
                            <Path Data="{StaticResource IconPlus}" Width="11" Height="11"
                                  Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Window Caption Buttons & Tabs Counter Badge & Tabs Toggle -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Quick Tab Orientation Toggle Button (Instant 1-click switch) -->
                <Button x:Name="BtnToggleTabOrientation"
                        Style="{StaticResource CaptionButtonStyle}"
                        Width="34" Height="30"
                        ToolTip="Переключить вертикальные / горизонтальные вкладки"
                        Click="BtnToggleTabOrientation_Click">
                    <Path x:Name="IconTabOrientation"
                          Data="{StaticResource IconTabsVertical}"
                          Width="13" Height="13" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}"/>
                </Button>

                <!-- Tab Counter Badge -->
                <Button x:Name="BtnTabsCounter"
                        Style="{StaticResource ModernButton}"
                        Height="26" Padding="8,0" Margin="2,0,6,0"
                        VerticalAlignment="Center"
                        Click="BtnTabsCounter_Click"
                        MouseEnter="BtnTabsCounter_MouseEnter"
                        ToolTip="Все открытые вкладки (нажмите или наведите)"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconGlobe}" Width="11" Height="11"
                              Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Margin="0,0,5,0"/>
                        <TextBlock x:Name="TxtTabsCount" Text="1" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Caption Buttons -->
                <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButtonStyle}" ToolTip="Свернуть" Click="BtnMinimize_Click">
                    <Path Width="10" Height="1" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True" Data="M 0,0.5 H 10"/>
                </Button>
                <Button x:Name="BtnMaximize" Style="{StaticResource CaptionButtonStyle}" ToolTip="Развернуть" Click="BtnMaximize_Click">
                    <Path Width="10" Height="10" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z"/>
                </Button>
                <Button x:Name="BtnClose" Style="{StaticResource CloseCaptionButtonStyle}" ToolTip="Закрыть" Click="BtnClose_Click">
                    <Path Width="10" Height="10" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True" Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ROW 1: TOOLBAR / ADDRESS BAR -->
        <StackPanel Grid.Row="1" x:Name="ToolbarRow1">
            <!-- EDIT MODE HELPER BANNER -->
            <Border x:Name="ToolbarEditModeBanner" Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1"
                    Padding="12,5" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconEdit}" Width="12" Height="12" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="Режим редактирования: перетаскивайте кнопки между панелями и строкой вкладок. 👁️ скрывает/показывает."
                                   FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="➕ Добавить отступ" Style="{StaticResource ModernButton}" Padding="8,2" FontSize="11" Margin="0,0,6,0" Click="BtnAddSpacer_Click"/>
                        <Button Content="Сбросить" Style="{StaticResource ModernButton}" Padding="8,2" FontSize="11" Margin="0,0,6,0" Click="BtnResetToolbar_Click"/>
                        <Button Content="✓ Готово" Style="{StaticResource AccentButton}" Padding="12,2" FontSize="11" Click="BtnExitEditMode_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Background="#A8111822" Panel.ZIndex="1"
                    BorderBrush="#293B50" BorderThickness="0,0,0,1"
                    Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Customizable Left Action Buttons -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Pill Address Bar Host -->
                        <ColumnDefinition Width="*"/>
                        <!-- Customizable Right Action Buttons -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Customizable Button Panel -->
                    <StackPanel Grid.Column="0" x:Name="ToolbarLeftPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                Background="Transparent"
                                AllowDrop="True" DragOver="ToolbarPanel_DragOver" Drop="ToolbarPanel_Drop" DragLeave="ToolbarPanel_DragLeave"/>

                    <!-- Center: Address Bar Host (Stretches across all available center width!) -->
                    <Border Grid.Column="1"
                            x:Name="ToolbarAddressBarHost"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            AllowDrop="True" DragOver="ToolbarPanel_DragOver" Drop="ToolbarPanel_Drop" DragLeave="ToolbarPanel_DragLeave"
                            Margin="0,0,0,0">
                        <Border x:Name="CardAddressBar"
                                Background="#E6162230"
                                BorderBrush="#364C66"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="10,0,6,0"
                                Height="36"
                                HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Lock / Security Icon -->
                                <Path Grid.Column="0"
                                      x:Name="IconSecurity"
                                      Data="{StaticResource IconLock}"
                                      Width="12" Height="12"
                                      Fill="{DynamicResource AccentBrush}"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      ToolTip="Безопасное HTTPS подключение"/>

                                <!-- URL / Search TextBox -->
                                <TextBox Grid.Column="1"
                                         x:Name="TxtAddress"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         FontSize="12"
                                         VerticalContentAlignment="Center"
                                         Padding="0"
                                         KeyDown="TxtAddress_KeyDown"
                                         GotFocus="TxtAddress_GotFocus"/>

                                <!-- Clear Button (when text is present) -->
                                <Button Grid.Column="2"
                                        x:Name="BtnClearAddress"
                                        Style="{StaticResource AddressNavButton}"
                                        Width="22" Height="22" Margin="2,0"
                                        ToolTip="Очистить"
                                        Click="BtnClearAddress_Click">
                                    <Path Data="{StaticResource IconClose}" Width="8" Height="8"
                                          Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform"/>
                                </Button>

                                <!-- Go / Search Button -->
                                <Button Grid.Column="3"
                                        x:Name="BtnGo"
                                        Style="{StaticResource AddressNavButton}"
                                        Width="26" Height="26"
                                        ToolTip="Перейти"
                                        Click="BtnGo_Click">
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="13" Width="24" Height="24">
                                        <Path Data="{StaticResource IconSend}" Width="10" Height="10"
                                              Fill="{DynamicResource AccentBrush}" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Right Customizable Button Panel -->
                    <StackPanel Grid.Column="2" x:Name="ToolbarRightPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                                Background="Transparent"
                                AllowDrop="True" DragOver="ToolbarPanel_DragOver" Drop="ToolbarPanel_Drop" DragLeave="ToolbarPanel_DragLeave"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ROW 2: PROGRESS INDICATOR -->
        <ProgressBar Grid.Row="2"
                     x:Name="BrowserProgressBar"
                     Height="2"
                     Minimum="0" Maximum="100" Value="0"
                     Foreground="{DynamicResource AccentBrush}"
                     Background="Transparent"
                     BorderThickness="0"
                     Visibility="Collapsed"/>

        <!-- ROW 3: BROWSER VIEW CONTAINER & START SCREEN -->
        <Grid Grid.Row="3" Background="#0C1017">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" x:Name="ColVerticalTabs"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Miniature Vertical Tabs Strip (always visible when BrowserVerticalTabs is true) -->
            <Border x:Name="VerticalTabsBar"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Width="48"
                    Background="#E6101722"
                    BorderBrush="#25374C"
                    BorderThickness="0,0,1,0"
                    Panel.ZIndex="30"
                    Visibility="Collapsed"
                    MouseEnter="VerticalTabsBar_MouseEnter">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- New Tab Mini Button -->
                    <Border Grid.Row="0" Padding="5,6,5,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Button Style="{StaticResource AddressNavButton}"
                                Width="36" Height="34"
                                ToolTip="Новая вкладка (Ctrl+T)"
                                Click="BtnNewTab_Click">
                            <Path Data="{StaticResource IconPlus}" Width="13" Height="13"
                                  Fill="{DynamicResource AccentBrush}" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Border>

                    <!-- Scrollable miniature vertical tabs list -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <ItemsControl x:Name="MiniVerticalTabsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="MiniVerticalTabsGroup"
                                                 IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                 Style="{StaticResource MiniVerticalTabButtonStyle}"
                                                 Click="TabButton_Click"
                                                 PreviewMouseDown="TabButton_PreviewMouseDown"
                                                 MouseEnter="TabButton_MouseEnter"
                                                 MouseLeave="TabButton_MouseLeave"
                                                 Tag="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Active WebView2 tabs container -->
            <Grid x:Name="BrowserHostGrid" Grid.Column="1"/>

            <!-- START SCREEN (displayed when no active tabs) -->
            <ScrollViewer x:Name="StartScreenContainer"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed"
                          Background="#0C1017">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,36" MaxWidth="720">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Prime Logo -->
                        <Border Width="76" Height="76" CornerRadius="20" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.4" Color="{DynamicResource AccentColor}"/>
                            </Border.Effect>
                            <Image Source="../Assets/prime_logo_app.png" Width="52" Height="52"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <TextBlock Text="Prime Browser" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                        <!-- Notification with Clickable "Сюда" -->
                        <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,26">
                            <TextBlock Text="Вы находитесь во встроенном браузере «Prime». Для отключения встроенного браузера нажмите "
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnGoToBrowserSettings"
                                    Content="Сюда"
                                    Cursor="Hand"
                                    Foreground="{DynamicResource AccentBrush}"
                                    FontWeight="Bold"
                                    FontSize="13"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="BtnGoToBrowserSettings_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   TextDecorations="Underline"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </WrapPanel>

                        <!-- Search Bar with Dropdown Menu on Right Edge -->
                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="24"
                                Height="48"
                                Width="600"
                                Padding="16,0,6,0"
                                HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.4" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Search Icon / Submit Button -->
                                <Button Grid.Column="0"
                                        Style="{StaticResource AddressNavButton}"
                                        Width="30" Height="30" Padding="0" Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Искать"
                                        Click="BtnStartSearchSubmit_Click">
                                    <Path Data="{StaticResource IconSearch}" Width="15" Height="15"
                                          Fill="{DynamicResource AccentBrush}" Stretch="Uniform"/>
                                </Button>

                                <!-- Input & Placeholder -->
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <TextBox x:Name="StartSearchTextBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource AccentBrush}"
                                             FontSize="13"
                                             Padding="0"
                                             VerticalAlignment="Center"
                                             KeyDown="StartSearchTextBox_KeyDown"
                                             TextChanged="StartSearchTextBox_TextChanged"
                                             GotFocus="StartSearchTextBox_GotFocus"
                                             LostFocus="StartSearchTextBox_LostFocus"/>

                                    <TextBlock x:Name="StartSearchPlaceholder"
                                               Text="Искать в Интернете или ввести адрес..."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="2,0,0,0"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=StartSearchTextBox}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Brand Dropdown Button -->
                                <Button x:Name="BtnStartSearchMenu"
                                        Grid.Column="2"
                                        Style="{StaticResource AddressNavButton}"
                                        Width="Auto" Height="34" Padding="12,0" Margin="4,0,0,0"
                                        Click="BtnStartSearchMenu_Click"
                                        ToolTip="Выбор основного браузера и поисковой системы">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCurrentEngineBadge" Text="Google" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <Path Data="{StaticResource IconChevronDown}" Width="8" Height="5"
                                              Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Recent Sites Section -->
                        <StackPanel Margin="0,32,0,0" Width="600" HorizontalAlignment="Center">
                            <DockPanel Margin="4,0,4,12">
                                <TextBlock Text="ПОСЛЕДНИЕ ПОСЕЩАЕМЫЕ САЙТЫ"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"/>
                                
                                <Button x:Name="BtnClearRecentSites"
                                        Content="Очистить историю"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        FontSize="11"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="BtnClearRecentSites_Click"
                                        ToolTip="Очистить историю недавних сайтов">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       TextDecorations="Underline"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DockPanel>

                            <!-- Empty placeholder -->
                            <Border x:Name="BrdNoRecentSites"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="18"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconGlobe}" Width="22" Height="22"
                                          Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform"
                                          HorizontalAlignment="Center" Margin="0,0,0,6" Opacity="0.5"/>
                                    <TextBlock Text="Здесь будут отображаться сайты, которые вы посещали."
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Информация сохраняется до очистки кэша браузера."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"
                                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Recent Sites ItemsControl -->
                            <ItemsControl x:Name="RecentSitesItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource StartScreenSiteTileButton}"
                                                Margin="0,0,10,12"
                                                Tag="{Binding}"
                                                Click="RecentSiteTile_Click"
                                                ToolTip="{Binding TooltipText}">
                                            <Border Background="{DynamicResource CardBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Width="110"
                                                    Height="84"
                                                    Padding="8,10">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0" Width="32" Height="32" CornerRadius="16"
                                                            Background="{DynamicResource HeaderBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            HorizontalAlignment="Center" Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding InitialLetter}"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding DisplayTitle}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- EDIT MODE OVERLAY (Hides web page during toolbar editing) -->
            <Border x:Name="EditModeOverlay"
                    Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{DynamicResource BackgroundBrush}"
                    Visibility="Collapsed"
                    Panel.ZIndex="40">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="16"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path Data="{StaticResource IconEdit}" Width="26" Height="26"
                              Fill="{DynamicResource AccentBrush}" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Вы в режиме редактирования" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Перетаскивайте кнопки между панелями инструментов и строкой вкладок.&#x0a;Используйте отступы для гибкой компоновки элементов."
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,24" LineHeight="20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="➕ Добавить отступ" Style="{StaticResource ModernButton}"
                                Padding="14,8" Margin="0,0,8,0" Click="BtnAddSpacer_Click"/>
                        <Button Content="Сбросить панели" Style="{StaticResource ModernButton}"
                                Padding="14,8" Margin="0,0,8,0" Click="BtnResetToolbar_Click"/>
                        <Button Content="✓ Готово" Style="{StaticResource AccentButton}"
                                Padding="18,8" FontWeight="SemiBold" Click="BtnExitEditMode_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- POPUP: VERTICAL TABS EXPANDABLE FLYOUT OVER ACTIVE PAGE -->
        <Popup x:Name="VerticalTabsPopup"
               PlacementTarget="{Binding ElementName=VerticalTabsBar}"
               Placement="Relative"
               HorizontalOffset="0"
               VerticalOffset="0"
               AllowsTransparency="True"
               StaysOpen="True">
            <Border x:Name="VerticalTabsPopupBorder"
                    Width="48"
                    Background="#F0131B26"
                    BorderBrush="#384D68"
                    BorderThickness="0,0,1,0"
                    MouseEnter="VerticalTabsPopupBorder_MouseEnter"
                    MouseLeave="VerticalTabsPopupBorder_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="0" Opacity="0.55" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Expanded New Tab Button -->
                    <Border Grid.Row="0" Padding="5,6,5,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Button Style="{StaticResource AddressNavButton}"
                                Height="34" HorizontalAlignment="Stretch"
                                ToolTip="Новая вкладка (Ctrl+T)"
                                Click="BtnNewTab_Click">
                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconPlus}" Width="13" Height="13"
                                      Fill="{DynamicResource AccentBrush}" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Новая вкладка" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                           Margin="2,0,8,0"/>
                            </Grid>
                        </Button>
                    </Border>

                    <!-- Scrollable expanded vertical tabs list -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <ItemsControl x:Name="VerticalTabsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="VerticalTabsGroup"
                                                 IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                 Style="{StaticResource BrowserVerticalTabButtonStyle}"
                                                 Click="TabButton_Click"
                                                 PreviewMouseDown="TabButton_PreviewMouseDown"
                                                 MouseEnter="TabButton_MouseEnter"
                                                 MouseLeave="TabButton_MouseLeave"
                                                 Tag="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>

        <!-- POPUP: TAB HOVER PREVIEW (Title, Screenshot, RAM Usage) -->
        <Popup x:Name="TabPreviewPopup"
               AllowsTransparency="True"
               Placement="Bottom"
               StaysOpen="True"
               PopupAnimation="None"
               IsHitTestVisible="False">
            <Border x:Name="TabPreviewCard"
                    Width="270"
                    Background="#E615202E"
                    BorderBrush="#3A506C"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="12"
                    Margin="12"
                    RenderTransformOrigin="0.5,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="6" Direction="270" Opacity="0.65" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Top: Favicon, Title, Domain -->
                        <RowDefinition Height="Auto"/>
                        <!-- Middle: Thumbnail Preview -->
                        <RowDefinition Height="Auto"/>
                        <!-- Bottom: Memory (RAM) Usage -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top: Header with Favicon, Title, Domain -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6"
                                Background="{DynamicResource HeaderBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Image x:Name="ImgPreviewFavicon" Width="14" Height="14" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPreviewTitle"
                                       Text="Новая вкладка"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="210"/>
                            <TextBlock x:Name="TxtPreviewDomain"
                                       Text="about:home"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="210"/>
                        </StackPanel>
                    </Grid>

                    <!-- Middle: Page Thumbnail Preview -->
                    <Border Grid.Row="1"
                            Height="145"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Background="{DynamicResource HeaderBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,10">
                        <Grid>
                            <Image x:Name="ImgPreviewThumbnail"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"/>
                            <Border x:Name="BrdPreviewPlaceholder" Visibility="Collapsed" Background="{DynamicResource HeaderBrush}">
