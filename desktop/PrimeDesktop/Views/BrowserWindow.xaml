                <StackPanel>
                    <TextBlock Text="НАСТРОЙКИ БРАУЗЕРА" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>

                    <!-- Search Engine -->
                    <TextBlock Text="Поисковая система:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbSearchEngine"
                              SelectionChanged="CmbSearchEngine_SelectionChanged"
                              Background="{DynamicResource HeaderBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Padding="8,5" Margin="0,0,0,12"/>

                    <!-- JavaScript Checkbox -->
                    <CheckBox x:Name="ChkEnableJs"
                              Content="Включить JavaScript"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              FontSize="12" Margin="0,0,0,8"
                              Checked="ChkEnableJs_Checked"
                              Unchecked="ChkEnableJs_Checked"/>

                    <!-- Cookies Checkbox -->
                    <CheckBox x:Name="ChkEnableCookies"
                              Content="Файлы Cookies и кэш"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              FontSize="12" Margin="0,0,0,8"
                              Checked="ChkEnableCookies_Checked"
                              Unchecked="ChkEnableCookies_Checked"/>

                    <!-- Desktop Mode Default Checkbox -->
                    <CheckBox x:Name="ChkDesktopMode"
                              Content="Режим ПК по умолчанию"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              FontSize="12" Margin="0,0,0,10"
                              Checked="ChkDesktopMode_Checked"
                              Unchecked="ChkDesktopMode_Checked"/>

                    <!-- Tab Layout Orientation -->
                    <TextBlock Text="Расположение вкладок:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="RbHorizontalTabs" Content="Горизонтальные" GroupName="BrowserTabOrientationGroup"
                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,12,0"
                                     Checked="RbTabOrientation_Checked"/>
                        <RadioButton x:Name="RbVerticalTabs" Content="Вертикальные" GroupName="BrowserTabOrientationGroup"
                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                                     Checked="RbTabOrientation_Checked"/>
                    </StackPanel>

                    <!-- Pencil Button for Toolbar Customization -->
                    <Button x:Name="BtnOpenCustomizerFromSettings"
                            Style="{StaticResource ModernButton}"
                            Padding="10,6" Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            Click="BtnCustomizeToolbar_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconEdit}" Width="12" Height="12" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Настроить кнопки браузера" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Extensions Button -->
                    <Button x:Name="BtnOpenExtensionsFromSettings"
                            Style="{StaticResource ModernButton}"
                            Padding="10,6" Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            Click="BtnExtensions_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconExtension}" Width="12" Height="12" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Расширения Chrome" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Clear Browsing Data Button -->
                    <Button Content="🧹 Очистить кэш и данные"
                            Style="{StaticResource ModernButton}"
                            Padding="10,6"
                            HorizontalAlignment="Stretch"
                            Click="BtnClearCache_Click"/>

                    <!-- Hidden Buttons Section (if any button is hidden) -->
                    <Border x:Name="BrdHiddenButtonsSection" Margin="0,12,0,0" Padding="0,10,0,0"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="СКРЫТЫЕ КНОПКИ ПАНЕЛИ" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="HiddenButtonsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource HeaderBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="8,5"
                                                Margin="0,0,0,5">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Style="{StaticResource AddressNavButton}"
                                                        Width="26" Height="26"
                                                        ToolTip="Вернуть на панель инструментов"
                                                        Tag="{Binding}"
                                                        Click="BtnRestoreHiddenButton_Click">
                                                    <Path Data="{StaticResource IconEye}" Width="12" Height="12"
                                                          Fill="{DynamicResource AccentBrush}" Stretch="Uniform"/>
                                                </Button>

                                                <Button Style="{StaticResource ModernButton}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="4,2"
                                                        Tag="{Binding}"
                                                        Click="BtnExecuteHiddenButton_Click">
                                                    <TextBlock Text="{Binding Title}" FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>

        <!-- POPUP: CHROME EXTENSIONS MANAGER -->
        <Popup x:Name="ExtensionsPopup"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Placement="Center">
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16"
                    Width="440"
                    MaxHeight="520"
                    SnapsToDevicePixels="True"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.65" Color="#000000"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                        <TranslateTransform X="0" Y="0"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.0" To="1.0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                 From="0.88" To="1.0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.25"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                 From="0.88" To="1.0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.25"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="🧩 РАСШИРЕНИЯ CHROME" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Action Bar: Add Extension (.crx, .zip, folder) & Chrome Store -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="➕ Установить расширение"
                                Style="{StaticResource AccentButton}"
                                Padding="10,6" Margin="0,0,8,0"
                                ToolTip="Установить файл расширения .crx, .zip или распакованную папку"
                                Click="BtnInstallExtension_Click"/>

                        <Button Content="🌐 Chrome Web Store"
                                Style="{StaticResource ModernButton}"
                                Padding="10,6"
                                ToolTip="Перейти в официальный каталог расширений Google Chrome"
                                Click="BtnOpenWebStore_Click"/>
                    </StackPanel>

                    <!-- Extensions List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Empty Placeholder -->
                            <TextBlock x:Name="TxtNoExtensions"
                                       Text="Нет установленных расширений. Вы можете добавить расширение из файла (.crx, .zip) или распакованной папки."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="6,12"
                                       Visibility="Collapsed"/>

                            <ItemsControl x:Name="ExtensionsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource HeaderBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Puzzle Icon -->
                                                <Path Grid.Column="0" Data="{StaticResource IconExtension}" Width="16" Height="16"
                                                      Fill="{DynamicResource AccentBrush}" Stretch="Uniform"
                                                      VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                <!-- Extension Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Version, StringFormat='Версия: {0}'}"
                                                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>

                                                <!-- Enable/Disable Checkbox -->
                                                <CheckBox Grid.Column="2"
                                                          Content="Вкл"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                                          FontSize="11"
                                                          VerticalAlignment="Center"
                                                          Margin="8,0"
                                                          Click="ExtensionEnabled_Changed"
                                                          Tag="{Binding}"/>

                                                <!-- Delete Extension Button -->
                                                <Button Grid.Column="3"
                                                        Style="{StaticResource AddressNavButton}"
                                                        Width="26" Height="26"
                                                        ToolTip="Удалить расширение"
                                                        Click="BtnDeleteExtension_Click"
                                                        Tag="{Binding}">
                                                    <Path Data="{StaticResource IconTrash}" Width="12" Height="12"
                                                          Fill="#FF5252" Stretch="Uniform"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Close -->
                    <Button Grid.Row="3"
                            Content="Закрыть"
                            HorizontalAlignment="Right"
                            Style="{StaticResource ModernButton}"
                            Padding="16,6"
                            Click="BtnCloseExtensions_Click"/>
                </Grid>
            </Border>
        </Popup>
        <!-- POPUP: ALL OPEN TABS DROPDOWN -->
