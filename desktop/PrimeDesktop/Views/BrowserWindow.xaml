                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Bottom: Memory Consumption (RAM) & State -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource HeaderBrush}"
                            CornerRadius="8"
                            Padding="10,6">
                        <DockPanel>
                            <TextBlock Text="⚡" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
