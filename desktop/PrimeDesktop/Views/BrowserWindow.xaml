                                            Cursor="Hand"
                                            Tag="{Binding}"
                                            PreviewMouseDown="TabsDropdownItem_PreviewMouseDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Favicon / Globe icon -->
                                            <Grid Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Image Source="{Binding Favicon}" Stretch="Uniform"
                                                       Visibility="{Binding Favicon, Converter={StaticResource BoolToVis}}"/>
                                                <Path Data="{StaticResource IconGlobe}" Fill="{DynamicResource TextSecondaryBrush}"
                                                      Stretch="Uniform" Width="12" Height="12"
                                                      Visibility="{Binding Favicon, Converter={StaticResource InverseBoolToVis}}"/>
                                            </Grid>

                                            <!-- Title -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>

                                            <!-- Close Button [x] -->
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource AddressNavButton}"
                                                    Width="20" Height="20"
                                                    Padding="0" Margin="4,0,0,0"
                                                    ToolTip="Закрыть вкладку"
                                                    Tag="{Binding}"
                                                    Click="BtnCloseTabFromDropdown_Click">
                                                <Path Data="{StaticResource IconClose}" Width="8" Height="8"
                                                      Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
