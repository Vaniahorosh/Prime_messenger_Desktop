<Window x:Class="PrimeDesktop.Views.AvatarCropperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка аватара профиля" Height="580" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#0F141C" BorderBrush="#223045" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.65" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title bar -->
                <RowDefinition Height="*"/>    <!-- Viewport -->
                <RowDefinition Height="Auto"/> <!-- Hint info -->
                <RowDefinition Height="Auto"/> <!-- Tools (Zoom/Rotate) -->
                <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,14" MouseDown="TitleBar_MouseDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👤" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Настройка аватара профиля" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right" Click="BtnCancel_Click"
                        Background="Transparent" Foreground="#8B949E" BorderThickness="0" FontSize="14" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#253247"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Viewport Container -->
            <Border Grid.Row="1" Background="#070A0F" CornerRadius="12" ClipToBounds="True" BorderBrush="#1C2536" BorderThickness="1">
                <Grid x:Name="ViewportGrid" ClipToBounds="True"
                      MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                      MouseMove="Viewport_MouseMove"
                      MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                      MouseWheel="Viewport_MouseWheel"
                      Cursor="Hand">

                    <!-- Canvas holding the transformed image -->
                    <Canvas x:Name="ImageCanvas" ClipToBounds="False" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Image x:Name="ImgPreview" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Canvas>

                    <!-- Semi-transparent Dark Mask with 15% Rounded Hole -->
                    <Path Fill="#B505080E" IsHitTestVisible="False">
                        <Path.Data>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry x:Name="CropFullRect"/>
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <RectangleGeometry x:Name="CropHoleRect" RadiusX="42" RadiusY="42"/>
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>

                    <!-- 15% Rounded Cropping Frame Border -->
                    <Border x:Name="CropBorder" BorderBrush="#4D9FFF" BorderThickness="2"
                            IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.4" Color="#4D9FFF"/>
                        </Border.Effect>
                    </Border>
                </Grid>
            </Border>

            <!-- Interaction Hint -->
            <TextBlock Grid.Row="2" Text="💡 Зажмите ЛКМ для перемещения • Ctrl + колесико для масштаба"
                       FontSize="11" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,10,0,8"/>

            <!-- Toolbar: Zoom & Rotate -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <!-- Zoom Out -->
                <Button Content="−" Width="34" Height="32" Click="BtnZoomOut_Click" ToolTip="Уменьшить"
                        Background="#16202E" Foreground="#C9D1D9" BorderBrush="#25354C" BorderThickness="1"
                        FontSize="15" FontWeight="Bold" Margin="0,0,6,0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
                <!-- Zoom In -->
                <Button Content="+" Width="34" Height="32" Click="BtnZoomIn_Click" ToolTip="Увеличить"
                        Background="#16202E" Foreground="#C9D1D9" BorderBrush="#25354C" BorderThickness="1"
                        FontSize="15" FontWeight="Bold" Margin="0,0,12,0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>

                <!-- Rotate CCW -->
                <Button Content="↶ -90°" Height="32" Padding="10,0" Click="BtnRotateCCW_Click" ToolTip="Повернуть влево"
                        Background="#16202E" Foreground="#C9D1D9" BorderBrush="#25354C" BorderThickness="1"
                        FontSize="12" Margin="0,0,6,0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
                <!-- Rotate CW -->
                <Button Content="↷ +90°" Height="32" Padding="10,0" Click="BtnRotateCW_Click" ToolTip="Повернуть вправо"
                        Background="#16202E" Foreground="#C9D1D9" BorderBrush="#25354C" BorderThickness="1"
                        FontSize="12" Margin="0,0,12,0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>

                <!-- Reset -->
                <Button Content="🔄 Сброс" Height="32" Padding="10,0" Click="BtnReset_Click" ToolTip="Сбросить масштаб и положение"
                        Background="#16202E" Foreground="#8B949E" BorderBrush="#25354C" BorderThickness="1"
                        FontSize="12" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
            </StackPanel>

            <!-- Bottom Actions -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Отмена" Click="BtnCancel_Click"
                        Background="#16202E" Foreground="#8B949E" BorderBrush="#25354C" BorderThickness="1"
                        Height="38" Width="110" HorizontalAlignment="Left" FontSize="13" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
                <Button Grid.Column="1" Content="✓ Применить" Click="BtnApply_Click"
                        Background="#4D9FFF" Foreground="#FFFFFF" FontWeight="Bold"
                        Height="38" Width="130" BorderThickness="0" FontSize="13" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
