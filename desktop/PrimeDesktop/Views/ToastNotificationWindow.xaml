<Window x:Class="PrimeDesktop.Views.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prime Notification"
        Height="78" Width="330"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PrimeDesktop;component/Resources/PrimeIcons.xaml"/>
                <ResourceDictionary Source="/PrimeDesktop;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootContainer" Margin="6">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTransform" X="60"/>
        </Grid.RenderTransform>

        <Border Background="#1D2736"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="10,8"
                Cursor="Hand"
                MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="4" Opacity="0.6"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar Column -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" ClipToBounds="True" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Grid>
                        <!-- Fallback Initials Avatar -->
                        <Border x:Name="AvatarFallback" Background="{DynamicResource AccentBrush}">
                            <TextBlock x:Name="TxtInitials" Text="?" Foreground="White" FontWeight="Bold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Photo Avatar -->
                        <Image x:Name="ImgAvatar" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Text Info Column -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock x:Name="TxtSender" Text="Отправитель" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtMessage" Text="Текст сообщения..." Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11.5" TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" Style="{StaticResource ModernButton}" Width="20" Height="20" Padding="0"
                        VerticalAlignment="Top" HorizontalAlignment="Right" Click="BtnClose_Click" ToolTip="Закрыть">
                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextMutedBrush}" Width="9" Height="9" Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
