<Window x:Class="PrimeDesktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PrimeDesktop.Converters"
        Title="Настройки — Prime Messenger"
        Icon="../Assets/prime.ico"
        Height="680" Width="820"
        MinHeight="540" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Animated Reset to Default Button Style -->
        <Style x:Key="ResetToDefaultButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Сбросить по умолчанию"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" SnapsToDevicePixels="True">
                            <Path x:Name="Icon" Data="{StaticResource IconRefresh}"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.3" To="1.0" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.3" To="1.0" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
        <conv:EqualityToVisibilityConverter x:Key="EqualityToVis"/>
        <conv:NonLockingImageConverter x:Key="NonLockingImgConverter"/>
        <conv:InitialsConverter x:Key="InitialsConverter"/>
        <Style x:Key="SettingsNavTabButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/> <!-- Custom TitleBar -->
            <RowDefinition Height="*"/>  <!-- Main 2-Column Body -->
            <RowDefinition Height="Auto"/> <!-- Bottom Actions Bar -->
        </Grid.RowDefinitions>

        <!-- Custom Windows 11 TitleBar -->
        <Grid Grid.Row="0" Background="{DynamicResource HeaderBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Title & Icon -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Image Source="../Assets/prime_logo_app.png" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Настройки Prime Messenger" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="6,2" Margin="10,0,0,0">
                    <TextBlock Text="v0.1 Desk" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
            </StackPanel>

            <!-- Window Control Buttons (Caption Buttons) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnMinimize"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="Свернуть"
                        Click="BtnMinimize_Click">
                    <Path Width="10" Height="1" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True" Data="M 0,0.5 H 10"/>
                </Button>

                <Button x:Name="BtnMaximize"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="Развернуть"
                        Click="BtnMaximize_Click">
                    <Grid>
                        <!-- Maximize icon (square) -->
                        <Path x:Name="IconMaximize" Width="10" Height="10" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" Visibility="Visible"/>
                        <!-- Restore icon (overlapping squares) -->
                        <Path x:Name="IconRestore" Width="10" Height="10" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True" Data="M 2.5,0.5 H 9.5 V 7.5 H 7.5 M 0.5,2.5 H 7.5 V 9.5 H 0.5 Z" Visibility="Collapsed"/>
                    </Grid>
                </Button>

                <Button x:Name="BtnClose"
                        Style="{StaticResource CloseCaptionButtonStyle}"
                        ToolTip="Закрыть (Esc)"
                        Click="BtnClose_Click">
                    <Path Width="10" Height="10" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True" Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Body: Left Navigation Strip + Right Tab Content -->
        <Grid Grid.Row="1" Margin="16,14,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="185"/> <!-- Left Category Tabs -->
                <ColumnDefinition Width="*"/>   <!-- Right Tab Content -->
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Strip (Exact 6 Android Tabs) -->
            <Border Grid.Column="0" Background="{DynamicResource BackgroundBrush}" CornerRadius="12" Padding="6" Margin="0,0,12,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Button Content="👤 Профиль" Command="{Binding SelectSettingsTabCommand}" CommandParameter="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSettingsTab}" Value="0">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="🎨 Оформление" Command="{Binding SelectSettingsTabCommand}" CommandParameter="1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSettingsTab}" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="💬 В чате" Command="{Binding SelectSettingsTabCommand}" CommandParameter="2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSettingsTab}" Value="2">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="🌐 Браузер" Command="{Binding SelectSettingsTabCommand}" CommandParameter="3">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSettingsTab}" Value="3">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="💾 Данные и память" Command="{Binding SelectSettingsTabCommand}" CommandParameter="4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSettingsTab}" Value="4">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="ℹ️ Информация" Command="{Binding SelectSettingsTabCommand}" CommandParameter="5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSettingsTab}" Value="5">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Right Tab Content Area -->
            <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                                    <StackPanel Visibility="{Binding SelectedSettingsTab, Converter={StaticResource EqualityToVis}, ConverterParameter=0}">
                                        <TextBlock Text="МОЙ ПРОФИЛЬ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="68" Height="68" CornerRadius="{Binding AvatarCornerRadius}" Background="{DynamicResource AccentBrush}" Margin="0,0,14,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding MyDisplayName, Converter={StaticResource InitialsConverter}}"
                                                               Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding Settings.MyAvatarPath, Converter={StaticResource NullToVis}}"/>

                                                    <Border CornerRadius="{Binding AvatarCornerRadius}" Visibility="{Binding Settings.MyAvatarPath, Converter={StaticResource NotNullToVis}}">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding Settings.MyAvatarPath, Converter={StaticResource NonLockingImgConverter}}" Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <StackPanel VerticalAlignment="Center">
                                                <Button Content="📷 Сменить мой аватар" Command="{Binding ChangeMyAvatarCommand}"
                                                        Style="{StaticResource ModernButton}" Padding="12,6" Margin="0,0,0,4"/>
                                                <Button Content="🗑️ Сбросить аватар" Command="{Binding ResetMyAvatarCommand}"
                                                        Style="{StaticResource ModernButton}" Padding="12,4" Margin="0,0,0,4"
                                                        Visibility="{Binding Settings.MyAvatarPath, Converter={StaticResource NotNullToVis}}"/>
                                                <TextBlock Text="Аватар и имя автоматически передаются собеседникам" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Text="Отображаемое имя" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding MyDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                                        <TextBlock Text="Имя пользователя (@username)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding MyUsername, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Path Data="{StaticResource IconLock}" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Безопасность профиля" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock Text="Физический MAC-адрес устройства надежно изолирован и никогда не передается в эфир. Локальное шифрование данных: AES-256-GCM."
                                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- TAB 1: Оформление и акценты -->
                                    <StackPanel Visibility="{Binding SelectedSettingsTab, Converter={StaticResource EqualityToVis}, ConverterParameter=1}">
                                        <TextBlock Text="ТЕМА ОФОРМЛЕНИЯ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Цветовая схема приложения:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <RadioButton Content="🌙 Тёмная" IsChecked="{Binding IsDarkThemeSelected, Mode=TwoWay}"
                                                         GroupName="ThemeModeGroup"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,18,0" VerticalAlignment="Center"/>
                                            <RadioButton Content="☀️ Светлая" IsChecked="{Binding IsLightThemeSelected, Mode=TwoWay}"
                                                         GroupName="ThemeModeGroup"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,18,0" VerticalAlignment="Center"/>
                                            <RadioButton Content="💻 Системная" IsChecked="{Binding IsSystemTheme, Mode=TwoWay}"
                                                         GroupName="ThemeModeGroup"
                                                         ToolTip="Автоматически адаптируется под тему Windows"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="ЦВЕТОВОЙ АКЦЕНТ ПРАЙМ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource ResetToDefaultButtonStyle}"
                                                    Command="{Binding ResetAccentColorCommand}"
                                                    Visibility="{Binding CanResetAccentColor, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Сбросить цвет по умолчанию (Prime Blue)"
                                                    DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                        </DockPanel>
                                        <TextBlock Text="Мгновенно применяется ко всем элементам интерфейса:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                        <WrapPanel Margin="0,0,0,14">
                                            <Button Background="#4D9FFF" ToolTip="Синий" Command="{Binding ChangeAccentColorCommand}" CommandParameter="#4D9FFF" Width="30" Height="30" Margin="4" Style="{StaticResource ModernButton}"/>
                                            <Button Background="#26A69A" ToolTip="Изумруд" Command="{Binding ChangeAccentColorCommand}" CommandParameter="#26A69A" Width="30" Height="30" Margin="4" Style="{StaticResource ModernButton}"/>
                                            <Button Background="#B388FF" ToolTip="Пурпур" Command="{Binding ChangeAccentColorCommand}" CommandParameter="#B388FF" Width="30" Height="30" Margin="4" Style="{StaticResource ModernButton}"/>
                                            <Button Background="#FFB74D" ToolTip="Янтарь" Command="{Binding ChangeAccentColorCommand}" CommandParameter="#FFB74D" Width="30" Height="30" Margin="4" Style="{StaticResource ModernButton}"/>
                                            <Button Background="#FF5252" ToolTip="Рубин" Command="{Binding ChangeAccentColorCommand}" CommandParameter="#FF5252" Width="30" Height="30" Margin="4" Style="{StaticResource ModernButton}"/>
                                            <Button Background="#4DD0E1" ToolTip="Циан" Command="{Binding ChangeAccentColorCommand}" CommandParameter="#4DD0E1" Width="30" Height="30" Margin="4" Style="{StaticResource ModernButton}"/>
                                            <Button Background="#FF4081" ToolTip="Розовый" Command="{Binding ChangeAccentColorCommand}" CommandParameter="#FF4081" Width="30" Height="30" Margin="4" Style="{StaticResource ModernButton}"/>
                                        </WrapPanel>

                                        <TextBlock Text="ФОРМА АВАТАРОК" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Скругление углов" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource ResetToDefaultButtonStyle}"
                                                    Command="{Binding ResetAvatarRadiusCommand}"
                                                    Visibility="{Binding CanResetAvatarRadius, Converter={StaticResource BoolToVis}}"
                                                    DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding AvatarCornerRadiusPercent, StringFormat='{}{0}%'}" DockPanel.Dock="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0" Minimum="0" Maximum="50" Value="{Binding AvatarCornerRadiusPercent, Mode=TwoWay}"
                                                    VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <Border Grid.Column="1" Width="44" Height="44" CornerRadius="{Binding PreviewAvatarCornerRadius}" Background="{DynamicResource AccentBrush}">
                                                <TextBlock Text="P" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="ФОРМА СООБЩЕНИЙ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Скругление блоков сообщений" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource ResetToDefaultButtonStyle}"
                                                    Command="{Binding ResetBubbleRadiusCommand}"
                                                    Visibility="{Binding CanResetBubbleRadius, Converter={StaticResource BoolToVis}}"
                                                    DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding BubbleRadius, StringFormat='{}{0} px'}" DockPanel.Dock="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0" Minimum="4" Maximum="24" Value="{Binding BubbleRadius, Mode=TwoWay}"
                                                    VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <Border Grid.Column="1" Width="80" Height="32" CornerRadius="{Binding BubbleCornerRadius}" Background="{DynamicResource AccentBrush}">
                                                <TextBlock Text="Привет!" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <CheckBox Content="Плавные анимации интерфейса" IsChecked="{Binding Settings.EnableAnimations, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                                        <CheckBox Content="Запускать Prime Messenger при старте Windows (автозапуск)"
                                                  IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    </StackPanel>

                                    <!-- TAB 2: В чате -->
                                    <StackPanel Visibility="{Binding SelectedSettingsTab, Converter={StaticResource EqualityToVis}, ConverterParameter=2}">
                                        <TextBlock Text="ФОНОВЫЕ ОБОИ ЧАТА" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Button Content="🖼️ Выбрать изображение..." Command="{Binding ChangeWallpaperCommand}"
                                                    Style="{StaticResource ModernButton}" Padding="12,6" Margin="0,0,8,0"/>
                                            <Button Content="✕ Сбросить обои" Command="{Binding ResetWallpaperCommand}"
                                                    Style="{StaticResource ModernButton}" Padding="12,6"/>
                                        </StackPanel>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Прозрачность обоев" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource ResetToDefaultButtonStyle}"
                                                    Command="{Binding ResetWallpaperOpacityCommand}"
                                                    Visibility="{Binding CanResetWallpaperOpacity, Converter={StaticResource BoolToVis}}"
                                                    DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding Settings.WallpaperOpacity, StringFormat='{}{0:P0}'}" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <Slider Minimum="0.1" Maximum="1.0" Value="{Binding Settings.WallpaperOpacity, Mode=TwoWay}"
                                                TickFrequency="0.05" Margin="0,0,0,16"/>


                                        <TextBlock Text="УВЕДОМЛЕНИЯ И ЗВУКИ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,8"/>
                                        <CheckBox Content="Всплывающие уведомления на рабочем столе" IsChecked="{Binding Settings.ShowToastNotifications, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                        <CheckBox Content="Показывать текст сообщения в превью" IsChecked="{Binding Settings.ShowMessagePreviewInNotifications, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="24,0,0,8"
                                                  IsEnabled="{Binding Settings.ShowToastNotifications}"/>

                                        <CheckBox Content="Звуковые сигналы и эффекты" IsChecked="{Binding Settings.PlayNotificationSounds, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                                        <StackPanel Margin="24,0,0,8" IsEnabled="{Binding Settings.PlayNotificationSounds}">
                                            <CheckBox Content="Звук входящего сообщения" IsChecked="{Binding Settings.PlayIncomingSound, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                            <CheckBox Content="Звук отправки сообщения" IsChecked="{Binding Settings.PlayOutgoingSound, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                            <CheckBox Content="Звук записи голосового сообщения" IsChecked="{Binding Settings.PlayVoiceRecordSound, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="Громкость звуковых эффектов" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource ResetToDefaultButtonStyle}"
                                                        Command="{Binding ResetSoundVolumeCommand}"
                                                        Visibility="{Binding CanResetSoundVolume, Converter={StaticResource BoolToVis}}"
                                                        DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Settings.SoundEffectsVolume, StringFormat='{}{0}%'}" DockPanel.Dock="Right"
                                                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Settings.SoundEffectsVolume, Mode=TwoWay}"
                                                        VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <Button Grid.Column="1" Style="{StaticResource ModernButton}" Content="Проверить 🔔"
                                                        Command="{Binding TestNotificationSoundCommand}"
                                                        Padding="10,3" Height="26" Background="#25FFFFFF"/>
                                            </Grid>
                                        </StackPanel>

                                        <TextBlock Text="СИСТЕМНЫЕ ОПЦИИ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,8"/>
                                        <CheckBox Content="Сворачивать в трей при закрытии окна" IsChecked="{Binding Settings.MinimizeToTray, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>

                                    <!-- TAB 3: Браузер -->
                                    <StackPanel Visibility="{Binding SelectedSettingsTab, Converter={StaticResource EqualityToVis}, ConverterParameter=3}">
                                        <TextBlock Text="ВСТРОЕННЫЙ БРАУЗЕР" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                        <CheckBox Content="Открывать веб-ссылки во встроенном окне" IsChecked="{Binding Settings.UseInternalBrowser, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Позволяет безопасно просматривать ссылки прямо в мессенджере без перехода в сторонние браузеры."
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,0,0,14" TextWrapping="Wrap"/>

                                        <TextBlock Text="ПОИСКОВАЯ СИСТЕМА" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Поисковая система по умолчанию:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding SearchEngines}" SelectedItem="{Binding SelectedSearchEngine}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource CardBrush}"
                                                  BorderBrush="{DynamicResource BorderBrush}" Padding="8,5" Margin="0,0,0,16"/>

                                        <TextBlock Text="ВЕБ-ДВИЖОК И БЕЗОПАСНОСТЬ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                        <CheckBox Content="Включить поддержку JavaScript" IsChecked="{Binding Settings.BrowserEnableJs, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                        <CheckBox Content="Разрешить файлы Cookies и кэширование" IsChecked="{Binding Settings.BrowserEnableCookies, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                        <CheckBox Content="Режим настольного ПК по умолчанию (Desktop Mode)" IsChecked="{Binding Settings.BrowserDesktopMode, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                                        <TextBlock Text="ОЧИСТКА ДАННЫХ БРАУЗЕРА" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                        <Button Content="🧹 Очистить кэш и cookies браузера" Command="{Binding ClearBrowserCacheCommand}"
                                                Style="{StaticResource ModernButton}" Padding="12,6" HorizontalAlignment="Left"/>
                                    </StackPanel>

                                    <!-- TAB 4: Данные и память -->
                                    <StackPanel Visibility="{Binding SelectedSettingsTab, Converter={StaticResource EqualityToVis}, ConverterParameter=4}">
                                        <TextBlock Text="ПАМЯТЬ И ХРАНИЛИЩЕ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>

                                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock Text="Всего занято:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding StorageTotalText}" DockPanel.Dock="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                </DockPanel>
                                                <TextBlock Text="Все фото, видео, аудио и документы сохраняются в локальном контейнере приложения."
                                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="КАТЕГОРИИ ДАННЫХ ДЛЯ ОЧИСТКИ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            <Button Content="Выбрать / Снять всё" Command="{Binding ToggleSelectAllStorageCommand}"
                                                    Style="{StaticResource ModernButton}" DockPanel.Dock="Right" Padding="8,3" FontSize="11"/>
                                        </DockPanel>

                                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                                            <StackPanel>
                                                <DockPanel Margin="0,2,0,4">
                                                    <CheckBox IsChecked="{Binding CbStoragePhotos, Mode=TwoWay}" Content="📷 Фотографии"
                                                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StoragePhotosText}" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>

                                                <DockPanel Margin="0,2,0,4">
                                                    <CheckBox IsChecked="{Binding CbStorageVideos, Mode=TwoWay}" Content="🎥 Видеозаписи и видео-заметки"
                                                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StorageVideosText}" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>

                                                <DockPanel Margin="0,2,0,4">
                                                    <CheckBox IsChecked="{Binding CbStorageAudio, Mode=TwoWay}" Content="🎵 Аудио и голосовые сообщения"
                                                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StorageAudioText}" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>

                                                <DockPanel Margin="0,2,0,4">
                                                    <CheckBox IsChecked="{Binding CbStorageGifs, Mode=TwoWay}" Content="🎭 GIF-анимации"
                                                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StorageGifsText}" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>

                                                <DockPanel Margin="0,2,0,4">
                                                    <CheckBox IsChecked="{Binding CbStorageFiles, Mode=TwoWay}" Content="📄 Файлы и документы"
                                                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StorageFilesText}" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>

                                                <DockPanel Margin="0,2,0,4">
                                                    <CheckBox IsChecked="{Binding CbStorageAvatars, Mode=TwoWay}" Content="👤 Кэш аватаров собеседников"
                                                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StorageAvatarsText}" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>

                                                <DockPanel Margin="0,2,0,2">
                                                    <CheckBox IsChecked="{Binding CbStorageCache, Mode=TwoWay}" Content="⚙️ Временный кэш приложения"
                                                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StorageCacheText}" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <Button Content="{Binding ClearSelectedStorageText}" Command="{Binding ClearSelectedStorageCommand}"
                                                    Style="{StaticResource ModernButton}" Padding="12,6" Margin="0,0,8,0"/>
                                            <Button Content="📂 Открыть папку данных" Command="{Binding OpenStorageFolderCommand}"
                                                    Style="{StaticResource ModernButton}" Padding="12,6"/>
                                        </StackPanel>

                                        <TextBlock Text="УПРАВЛЕНИЕ ИСТОРИЕЙ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                        <Button Content="🗑️ Удалить все чаты и историю сообщений" Command="{Binding ClearAllChatsCommand}"
                                                Style="{StaticResource ModernButton}" Foreground="#FF6B6B" Padding="12,6" Margin="0,0,0,4" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Безвозвратно удаляет локальную базу сообщений и кэш контактов."
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                        <TextBlock Text="БЕЗОПАСНОСТЬ И КОНФИДЕНЦИАЛЬНОСТЬ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                        <CheckBox Content="Запретить снимок или съемку мессенджера"
                                                  IsChecked="{Binding Settings.EnableScreenshotProtection, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Блокирует создание скриншотов, запись экрана и захват окна мессенджера сторонними программами (Windows Display Affinity)."
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- TAB 5: Информация (Android Parity) -->
                                    <StackPanel Visibility="{Binding SelectedSettingsTab, Converter={StaticResource EqualityToVis}, ConverterParameter=5}">
                                        <StackPanel HorizontalAlignment="Center" Margin="0,4,0,12">
                                            <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6" HorizontalAlignment="Center">
                                                <Image Source="../Assets/prime_logo_app.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <TextBlock Text="Prime Desktop" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Версия 0.1 Desk (Windows x64)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            <TextBlock Text="«Всё нужное без лишнего!»" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Card 1: Исходный код -->
                                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8">
                                            <DockPanel>
                                                <Button Content="Открыть GitHub" Command="{Binding OpenGithubCommand}"
                                                        Style="{StaticResource ModernButton}" DockPanel.Dock="Right" Padding="10,5" FontSize="11"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Исходный код" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="Репозиторий мессенджера на GitHub" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- Card 2: Сообщить о проблеме -->
                                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8">
                                            <DockPanel>
                                                <Button Content="Проверить обновления" Command="{Binding CheckUpdatesCommand}"
                                                        Style="{StaticResource ModernButton}" DockPanel.Dock="Right" Padding="10,5" FontSize="11"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Сообщить о проблеме" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="Prime Messenger v0.1 Desk" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- Card 3: Благодарности (cardThanks) -->
                                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="Благодарности" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                    <Button Content="{Binding ThanksHeartCount, StringFormat='❤️ Спасибо! ({0})'}"
                                                            Command="{Binding SendHeartCommand}" ToolTip="Отправить благодарность"
                                                            Style="{StaticResource ModernButton}" Foreground="#FF2A55" DockPanel.Dock="Right" Padding="10,4" FontSize="11" FontWeight="Bold"/>
                                                </DockPanel>
                                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,2,0,6"/>
                                                <DockPanel Margin="0,2,0,2">
                                                    <TextBlock Text="Главный разработчик: " FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Button Content="Vaniahorosh" Command="{Binding OpenDevGithubCommand}"
                                                            Style="{StaticResource ModernButton}" Padding="4,1" Margin="2,0,0,0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                </DockPanel>
                                                <TextBlock Text="Помощник программиста: Gemini, Claude code" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                                                <TextBlock Text="Автор идеи: Иван" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 4: Протокол и безопасность -->
                                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="ПРОТОКОЛ И СОВМЕСТИМОСТЬ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2"/>
                                                <TextBlock Text="UUID: fa87c0d0-afac-11de-8a39-0800200c9a66&#x0a;Аппаратное локальное шифрование AES-256-GCM. Полная совместимость с мобильной версией Prime Messenger."
                                                           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>
        </Grid>

        <!-- Bottom Actions Bar -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <Button Content="Закрыть" Style="{StaticResource ModernButton}" Click="BtnClose_Click" Padding="18,7"/>
                <Button Content="Применить" Style="{StaticResource AccentButton}" Command="{Binding SaveSettingsCommand}" DockPanel.Dock="Right" Padding="20,7" Visibility="{Binding HasPendingSettingsChanges, Converter={StaticResource BoolToVis}}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
