<Window x:Class="PrimeDesktop.Views.PrimeDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Диалог"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <Grid Background="Transparent">
        <!-- Dialog Glass Card Container -->
        <Border x:Name="DialogCard"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="24"
                MinWidth="380"
                MaxWidth="480"
                Margin="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.55" Color="#000000"/>
            </Border.Effect>

            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="0.82" ScaleY="0.82" CenterX="200" CenterY="130"/>
                    <TranslateTransform x:Name="CardTranslate" Y="40"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid Margin="24,24,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Icon -->
                    <RowDefinition Height="Auto"/> <!-- Title -->
                    <RowDefinition Height="Auto"/> <!-- Message -->
                    <RowDefinition Height="Auto"/> <!-- Custom View or Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Buttons Row -->
                </Grid.RowDefinitions>

                <!-- Icon (Optional) -->
                <Border x:Name="IconBadge"
                        Grid.Row="0"
                        Width="52" Height="52"
                        CornerRadius="26"
                        Background="#1F4D9FFF"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <Path x:Name="IconPath"
                          Data="{StaticResource IconInfo}"
                          Fill="{DynamicResource AccentBrush}"
                          Width="24" Height="24"
                          Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title -->
                <TextBlock x:Name="TxtTitle"
                           Grid.Row="1"
                           Text="Заголовок"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <!-- Message -->
                <TextBlock x:Name="TxtMessage"
                           Grid.Row="2"
                           Text="Текст сообщения"
                           FontSize="13.5"
                           LineHeight="20"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <!-- Custom Content Placeholder -->
                <ContentPresenter x:Name="CustomContentHost"
                                  Grid.Row="3"
                                  Margin="0,0,0,16"
                                  Visibility="Collapsed"/>

                <!-- Action Buttons (Cancel / Confirm) -->
                <Grid Grid.Row="4" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" x:Name="ColNegative"/>
                        <ColumnDefinition Width="10" x:Name="ColSpacer"/>
                        <ColumnDefinition Width="*" x:Name="ColPositive"/>
                    </Grid.ColumnDefinitions>

                    <!-- Negative Button (e.g. Отмена / Нет) -->
                    <Button x:Name="BtnNegative"
                            Grid.Column="0"
                            Content="Отмена"
                            Height="42"
                            Style="{StaticResource ModernButton}"
                            FontWeight="SemiBold"
                            FontSize="13.5"
                            Click="BtnNegative_Click"/>

                    <!-- Positive Button (e.g. Удалить / Да / OK) -->
                    <Button x:Name="BtnPositive"
                            Grid.Column="2"
                            Content="ОК"
                            Height="42"
                            Style="{StaticResource AccentButton}"
                            FontWeight="SemiBold"
                            FontSize="13.5"
                            Click="BtnPositive_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
