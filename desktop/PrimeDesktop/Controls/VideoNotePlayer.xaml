<UserControl x:Class="PrimeDesktop.Controls.VideoNotePlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="190" d:DesignWidth="190"
             Width="190" Height="190">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PrimeDesktop;component/Resources/PrimeIcons.xaml"/>
                <ResourceDictionary Source="/PrimeDesktop;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="PART_RootBorder"
            Width="190" Height="190"
            Background="#0F151F"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="2"
            ClipToBounds="True"
            Cursor="Hand"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">

        <Grid x:Name="PART_MainGrid">
            <!-- MediaElement for Video Note -->
            <MediaElement x:Name="PART_Media"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          Stretch="UniformToFill"
                          IsMuted="False"
                          MediaOpened="Media_MediaOpened"
                          MediaEnded="Media_MediaEnded"
                          MediaFailed="Media_MediaFailed"/>

            <!-- Center Paused Indicator Overlay -->
            <Grid x:Name="PART_PauseOverlay"
                  Background="#55000000"
                  Visibility="Collapsed">
                <Border Width="46" Height="46" CornerRadius="23"
                        Background="#90000000"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Path Data="{StaticResource IconPlay}"
                          Fill="White"
                          Width="16" Height="16"
                          Margin="2,0,0,0"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Bottom Floating Control Bar -->
            <Border VerticalAlignment="Bottom"
                    Background="#88000000"
                    CornerRadius="12"
                    Padding="6,3"
                    Margin="10,0,10,8"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Mute / Unmute Button -->
                    <Button x:Name="BtnMute"
                            Style="{StaticResource ModernButton}"
                            Width="22" Height="22" Padding="0"
                            Margin="0,0,6,0"
                            ToolTip="Звук (Вкл/Выкл)"
                            Click="BtnMute_Click">
                        <Grid>
                            <Path x:Name="IconSoundOn"
                                  Data="{StaticResource IconVolumeUp}"
                                  Fill="White" Width="12" Height="12"
                                  Stretch="Uniform"/>
                            <Path x:Name="IconSoundOff"
                                  Data="{StaticResource IconVolumeMute}"
                                  Fill="#FF8888" Width="12" Height="12"
                                  Stretch="Uniform"
                                  Visibility="Collapsed"/>
                        </Grid>
                    </Button>

                    <!-- Time Progress -->
                    <TextBlock x:Name="TxtTime"
                               Text="0:00"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <!-- Speed Button (1x, 1.5x, 2x) -->
                    <Border CornerRadius="10" Background="#30FFFFFF">
                        <Button x:Name="BtnSpeed"
                                Style="{StaticResource ModernButton}"
                                Padding="6,1" Height="20"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="Скорость воспроизведения"
                                Click="BtnSpeed_Click">
                            <TextBlock x:Name="TxtSpeed"
                                       Text="1x"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Button>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
