<UserControl x:Class="PrimeDesktop.Controls.EmojiPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             Width="340" Height="380">

    <Border Background="#131B26"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Search Box -->
                <RowDefinition Height="Auto"/> <!-- Category Tabs -->
                <RowDefinition Height="*"/>    <!-- Emojis Scroll Viewer -->
                <RowDefinition Height="Auto"/> <!-- Preview Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Search Box -->
            <Border Grid.Row="0" Background="#182333" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Height="34" Margin="10,10,10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{DynamicResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBox Grid.Column="1" x:Name="TxtSearch"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="12" VerticalAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock Grid.Column="1" x:Name="PlaceholderSearch" Text="Поиск смайликов..."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                               VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"/>
                    <Button Grid.Column="2" x:Name="BtnClearSearch" Content="✕"
                            Style="{StaticResource ModernButton}" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Padding="0"
                            Visibility="Collapsed" Click="BtnClearSearch_Click"/>
                </Grid>
            </Border>

            <!-- 2. Category Tabs Bar -->
            <Border Grid.Row="1" Background="#0E141D" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="6,4">
                <ItemsControl x:Name="CategoryTabsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ModernButton}"
                                    Width="34" Height="32" Padding="0" Margin="2,0"
                                    Background="{Binding BackgroundBrush}"
                                    BorderBrush="{Binding BorderBrush}"
                                    ToolTip="{Binding Title}"
                                    Tag="{Binding CategoryId}"
                                    Click="CategoryTabButton_Click">
                                <emoji:TextBlock Text="{Binding TabIcon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 3. Emojis Scroll Area -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,6">
                <StackPanel>
                    <!-- Quick Recent / Favorites Row (Only visible when search is empty) -->
                    <StackPanel x:Name="QuickFavoritesPanel">
                        <TextBlock Text="ПОПУЛЯРНЫЕ" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="4,2,4,4"/>
                        <ItemsControl x:Name="FavoritesControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Character}" Style="{StaticResource EmojiTileButton}"
                                            Tag="{Binding}"
                                            Click="EmojiButton_Click"
                                            MouseEnter="EmojiButton_MouseEnter"
                                            MouseLeave="EmojiButton_MouseLeave"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="4,6,4,6"/>
                    </StackPanel>

                    <!-- Section Title -->
                    <TextBlock x:Name="SectionTitleText" Text="Смайлы и эмоции"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="4,2,4,4"/>

                    <!-- Main Emojis Grid -->
                    <ItemsControl x:Name="EmojisGridControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Character}" Style="{StaticResource EmojiTileButton}"
                                        Tag="{Binding}"
                                        Click="EmojiButton_Click"
                                        MouseEnter="EmojiButton_MouseEnter"
                                        MouseLeave="EmojiButton_MouseLeave"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. Preview Footer -->
            <Border Grid.Row="3" Background="#0C121A" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,6" Height="40">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <emoji:TextBlock Grid.Column="0" x:Name="FooterEmojiIcon" Text="✨" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="FooterEmojiName" Text="Prime Emojis • Выберите смайлик"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
