<UserControl x:Class="PrimeDesktop.Controls.ExpandedReactionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320" MaxHeight="360">

    <Border Background="#131B26"
            BorderBrush="#25354C"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.65" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title & Search -->
                <RowDefinition Height="*"/>    <!-- Emojis Grid -->
                <RowDefinition Height="Auto"/> <!-- Full Picker Toggle -->
            </Grid.RowDefinitions>

            <!-- Header: Title + Search Box -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Реакции" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,10,0"/>

                <Border Grid.Column="1" Background="#182333" BorderBrush="#25354C" BorderThickness="1" CornerRadius="8" Height="28" Padding="6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtFilter"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="11" VerticalAlignment="Center"
                                 TextChanged="TxtFilter_TextChanged"/>
                        <TextBlock Grid.Column="1" x:Name="PlaceholderFilter" Text="Найти реакцию..."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"/>
                        <Button Grid.Column="2" x:Name="BtnClearFilter" Content="✕"
                                Style="{StaticResource ModernButton}" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Padding="0"
                                Visibility="Collapsed" Click="BtnClearFilter_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Emojis Scroll View -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="240">
                <ItemsControl x:Name="ReactionsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ModernButton}"
                                    Width="36" Height="36" Padding="0" Margin="2"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" ToolTip="{Binding Name}"
                                    Tag="{Binding Character}"
                                    Click="ReactionButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                            </Border.RenderTransform>
                                            <TextBlock Text="{Binding Character}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#25354C"/>
                                                <Setter TargetName="Bd" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="1.22" ScaleY="1.22"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Bottom: Open Full Emoji Catalog -->
            <Border Grid.Row="2" BorderBrush="#1F2E42" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,6,0,0">
                <Button x:Name="BtnMoreEmojis" Style="{StaticResource ModernButton}"
                        Background="#162334" BorderBrush="#25354C" BorderThickness="1"
                        Padding="8,4" HorizontalAlignment="Stretch" Cursor="Hand"
                        Click="BtnMoreEmojis_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="✨" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Все эмодзи мессенджера..." Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>
        </Grid>
    </Border>
</UserControl>
