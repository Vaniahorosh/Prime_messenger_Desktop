<UserControl x:Class="PrimeDesktop.Controls.ExpandedReactionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="350" MaxHeight="440">

    <Border Background="#101824"
            BorderBrush="#25374E"
            BorderThickness="1"
            CornerRadius="20"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.75" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title & Search -->
                <RowDefinition Height="Auto"/> <!-- Categories -->
                <RowDefinition Height="*"/>    <!-- Emojis Grid -->
                <RowDefinition Height="Auto"/> <!-- Full Picker Toggle -->
            </Grid.RowDefinitions>

            <!-- Header: Title + Search Box + Close Button -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Реакции" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,10,0"/>

                <Border Grid.Column="1" Background="#162232" BorderBrush="#263850" BorderThickness="1" CornerRadius="8" Height="30" Padding="8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtFilter"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 FontSize="12" VerticalAlignment="Center"
                                 KeyDown="TxtFilter_KeyDown"
                                 TextChanged="TxtFilter_TextChanged"/>
                        <TextBlock Grid.Column="1" x:Name="PlaceholderFilter" Text="Найти реакцию..."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"/>
                        <Button Grid.Column="2" x:Name="BtnClearFilter" Content="✕"
                                Style="{StaticResource ModernButton}" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Padding="2"
                                Visibility="Collapsed" Click="BtnClearFilter_Click"/>
                    </Grid>
                </Border>

                <!-- Close Button (✕) -->
                <Button Grid.Column="2" x:Name="BtnClose" Style="{StaticResource ModernButton}" Width="26" Height="26" Margin="6,0,0,0"
                        ToolTip="Закрыть (Esc)" Click="BtnClose_Click">
                    <Path Data="{StaticResource IconClose}" Width="9" Height="9" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- Category Pills Bar -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                <StackPanel x:Name="CategoriesPanel" Orientation="Horizontal">
                    <Button x:Name="BtnCatAll" Content="Все" Style="{StaticResource ModernButton}"
                            Padding="10,4" Margin="0,0,5,0" FontSize="11" FontWeight="SemiBold"
                            Background="#254E82" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="CategoryButton_Click" Tag="all"/>
                    <Button x:Name="BtnCatTop" Content="🔥 Топ" Style="{StaticResource ModernButton}"
                            Padding="9,4" Margin="0,0,5,0" FontSize="11" FontWeight="SemiBold"
                            Background="#182436" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="CategoryButton_Click" Tag="top"/>
                    <Button x:Name="BtnCatFaces" Content="😀 Эмоции" Style="{StaticResource ModernButton}"
                            Padding="9,4" Margin="0,0,5,0" FontSize="11" FontWeight="SemiBold"
                            Background="#182436" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="CategoryButton_Click" Tag="faces"/>
                    <Button x:Name="BtnCatHands" Content="👍 Жесты" Style="{StaticResource ModernButton}"
                            Padding="9,4" Margin="0,0,5,0" FontSize="11" FontWeight="SemiBold"
                            Background="#182436" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="CategoryButton_Click" Tag="hands"/>
                    <Button x:Name="BtnCatHearts" Content="💖 Сердца" Style="{StaticResource ModernButton}"
                            Padding="9,4" Margin="0,0,5,0" FontSize="11" FontWeight="SemiBold"
                            Background="#182436" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="CategoryButton_Click" Tag="hearts"/>
                    <Button x:Name="BtnCatSymbols" Content="⭐ Знаки" Style="{StaticResource ModernButton}"
                            Padding="9,4" Margin="0,0,0,0" FontSize="11" FontWeight="SemiBold"
                            Background="#182436" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="CategoryButton_Click" Tag="symbols"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Emojis Scroll View -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="250">
                <ItemsControl x:Name="ReactionsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ModernButton}"
                                    Width="38" Height="38" Padding="0" Margin="2"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" ToolTip="{Binding Name}"
                                    Tag="{Binding Character}"
                                    Click="ReactionButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" 
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                            </Border.RenderTransform>
                                            <TextBlock Text="{Binding Character}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#253952"/>
                                                <Setter TargetName="Bd" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="1.26" ScaleY="1.26"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1A293D"/>
                                                <Setter TargetName="Bd" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="1.38" ScaleY="1.38"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Bottom: Open Full Emoji Catalog -->
            <Border Grid.Row="3" BorderBrush="#1D2D42" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                <Button x:Name="BtnMoreEmojis" Style="{StaticResource ModernButton}"
                        Background="#162335" BorderBrush="#253850" BorderThickness="1"
                        Padding="10,6" HorizontalAlignment="Stretch" Cursor="Hand" 
                        Click="BtnMoreEmojis_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="✨" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Все эмодзи мессенджера..." Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>
        </Grid>
    </Border>
</UserControl>
