<UserControl x:Class="PrimeDesktop.Controls.VideoPreviewPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="220" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PrimeDesktop;component/Resources/PrimeIcons.xaml"/>
                <ResourceDictionary Source="/PrimeDesktop;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="PART_RootBorder"
            CornerRadius="10"
            Background="#121824"
            BorderBrush="#30FFFFFF"
            BorderThickness="1"
            ClipToBounds="True"
            MaxWidth="340"
            MaxHeight="260"
            MinWidth="180"
            MinHeight="130"
            Cursor="Hand"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">

        <Grid x:Name="PART_MainGrid">
            <!-- MediaElement for looping muted video preview -->
            <MediaElement x:Name="PART_Media"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          Stretch="UniformToFill"
                          IsMuted="True"
                          Volume="0"
                          MediaOpened="Media_MediaOpened"
                          MediaEnded="Media_MediaEnded"
                          MediaFailed="Media_MediaFailed"/>

            <!-- Gradient bottom shadow to ensure duration text is always readable -->
            <Border VerticalAlignment="Bottom" Height="50" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#90000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Center Play Indicator Overlay -->
            <Border x:Name="PART_PlayOverlay"
                    Width="46" Height="46" CornerRadius="23"
                    Background="#75000000"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1.5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Path Data="{StaticResource IconPlay}"
                      Fill="White"
                      Width="16" Height="16"
                      Margin="2,0,0,0"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Border>

            <!-- Top Left "GIF" / Preview Pill -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="#75000000"
                    CornerRadius="6"
                    Padding="6,2"
                    Margin="8,8,0,0"
                    IsHitTestVisible="False">
                <TextBlock Text="GIF" Foreground="#CCFFFFFF" FontSize="10" FontWeight="Bold"/>
            </Border>

            <!-- Bottom Right Duration Badge -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="#80000000"
                    CornerRadius="6"
                    Padding="6,2"
                    Margin="0,0,8,8"
                    IsHitTestVisible="False">
                <TextBlock x:Name="TxtDuration"
                           Text="{Binding Duration, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="White"
                           FontSize="11"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
