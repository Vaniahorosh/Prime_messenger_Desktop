{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrimeMessenger",
  "version": "2.0.0",
  "identifier": "com.primemessenger.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Prime Messenger",
        "width": 1100,
        "height": 740,
        "minWidth": 420,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  }
}
